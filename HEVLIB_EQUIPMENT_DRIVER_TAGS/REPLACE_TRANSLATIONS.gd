		},
		"SHIP_EIME_B_SPECS": {
			"string": "制造商：埃隆星际\n高强度挂载点：1\n低强度挂载点：2\n乘员上限：5\n干重：27240kg\n货舱容量：140m^3\n成品矿物容量（每种）：11000kg",
			"version_hash": 919535865
		},
		"SHIP_EIME_B_DESC": {
			"string": "作为如今臭名昭著的Model E的前身，Model B（昵称“Bubba”）曾试图沿用 K37 系列飞船上那套久经考验的推进器设计。尽管初期测试反响极佳，但人们很快发现其布局存在不稳定性，会对反应堆施加超出标称运行标准的应力，因此该型号被迫停产并退回设计阶段。不过，仍有少量该型飞船在役，这归功于一部分钟情于其原始设计自由度、且驾驶技术足以驾驭这种不稳定性的飞行员。",
			"version_hash": 1810821042
		}
