		"IOE_TUNE_FAB_SPEED": {
			"string": "Скорость печати фабрикатора",
			"version_hash": 4127227909
		},
		"IOE_TUNE_FAB_SPEED_DESC": {
			"string": "Изменяет скорость, с которой фабрикатор превращает переработанную руду в расходные материалы. Чем выше темп производства, тем сильнее потери эффективности и тем больше требуется энергии и сырья.",
			"version_hash": 3230248524
		},
		"IOE_TUNE_PARAMETER_PRINT_POWER_DRAW": {
			"string": "Мощность печати",
			"version_hash": 3168425227
		},
		"IOE_TUNE_PARAMETER_PRINT_MATERIAL_EFFICIENCY": {
			"string": "Дополнительный расход сырья из-за потерь",
			"version_hash": 2047110542
		},
		"SYSTEM_MWTIGHTBEAM": {
			"string": "НМВ пушка RA",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_DESC": {
			"string": "Направленная микроволновая пушка Rusatom-Antonoff использует длинный трубчатый волновод для концентрации микроволн в узкий пучок излучения. Модульные и неспециализированные компоненты пушки дешевы и просты в ремонте, но их преимущества компенсируются высокой стоимостью установки и средней энергоэффективностью.",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_SPECS": {
			"string": "Эффективная дистанция: 800 м \nЭнергопотребление: 120 МВт \nВыходная мощность: 90 МВт \nДлина волны: 1 см \nМасса: 400 кг \nПроизводитель: Rusatom-Antonoff",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_PDT": {
			"string": "НМВ турель RA",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_PDT_DESC": {
			"string": "Эта версия НМВ пушки Rusatom-Antonoff установлена ​​на корпусе турели NDPT Nakamura Dynamics. Она обладает аналогичными характеристиками управляемости и настраиваемыми параметрами конфигурации, как и линейка рельсовых пушек 42xx для точечной обороны, хотя её карданный привод пришлось понизить для надлежащего управления тяжёлой кабельной системой питания. \n\nНМВ турель может автоматически захватывать и сопровождать цели, но, в отличие от рельсотрона, не требует ручного управления для стрельбы.",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_PDT_SPECS": {
			"string": "Эффективная дальность: 2000 м \n ИИ наведения: Класс 1 \nЭнергопотребление: 120 МВт \nВыходная мощность: 90 МВт \nДлина волны: 1 см \nМасса: 3000 кг \nПроизводитель: Rusatom",
			"version_hash": 0
		},
		"SYSTEM_PDTL": {
			"string": "Лазерная турель NDCL-80 для точечной обороны",
			"version_hash": 0
		},
		"SYSTEM_PDTL_MANUAL": {
			"string": "Автоматически выбирает цели.\nСтреляет автоматически.\nКоординирует по нескольким системам.\nКомпьютер наведения несовершенен.\nОтключите подвес, чтобы предотвратить случайный огонь по своим.\nНаносит термический урон.",
			"version_hash": 0
		},
		"SYSTEM_PDTL_DESC": {
			"string": "Небольшой лазер, закреплённый на основании башни, обеспечивает широкий охват с точки крепления. Низкая мощность лазера приводит к увеличению нагрузки на разрушение камней, однако снижает наносимый целям урон. Он стреляет автоматически, поэтому пользователям рекомендуется контролировать работу систем опознавания «свой-чужой» (IFF) для предотвращения нежелательных столкновений. \n\nАППАРАТНОЕ ОБЕСПЕЧЕНИЕ ПРЕДОСТАВЛЯЕТСЯ «КАК ЕСТЬ», БЕЗ КАКИХ-ЛИБО ГАРАНТИЙ, ЯВНЫХ ИЛИ ПОДРАЗУМЕВАЕМЫХ. ПОЛЬЗОВАТЕЛЬ НЕСЁТ ВСЮ ОТВЕТСТВЕННОСТЬ ПРИ ИСПОЛЬЗОВАНИИ ДАННОГО ОБОРУДОВАНИЯ.",
			"version_hash": 0
		},
		"SYSTEM_PDTL_SPECS": {
			"string": "Эффективная дальность: 1000 м \nИИ наведения: Класс 1 \nЭнергопотребление (пиковая): 80 МВт \nМасса: 1500 кг \nПроизводитель: Nakamura Dynamics, Coherent Light",
			"version_hash": 0
		},
		"POI_WRECKAGE_UNKNOWN": {
			"string": "Неизвестные обломки",
			"version_hash": 3678810514
		},
		"SYSTEM_IOE_AUX_HYBRID": {
			"string": "Гибридный энергоблок RA MHFTR",
			"version_hash": 1382394920
		},
		"SYSTEM_IOE_AUX_HYBRID_DESC": {
			"string": "Изначально эти генераторы MPD предназначались для неудачных прототипов K44, после чего десятилетиями лежали на складах. Чтобы избавиться от неиспользуемых запасов, Rusatom поручил небольшой группе найти применение старым MPDG. Одна из проектных команд вернулась к исходной идее полной замены штатной энергосистемы корабля и добавила современный накопитель SMES для кратковременного хранения энергии.\\n\\nБлок оказался дорогим и слишком тяжёлым для прямой замены стандартной силовой установки — словно повторяя судьбу K44. Однако сочетание технологий позволило снизить внешнее энергопотребление благодаря возврату части выработанной мощности. Небольшая солевая батарея обеспечивает запуск после перезагрузки. В итоге систему высоко оценили как технические энтузиасты, так и горнодобывающие компании.",
			"version_hash": 1374895143
		},
		"SYSTEM_IOE_AUX_HYBRID_SPECS": {
			"string": "Ёмкость SMES: 13 500 МДж\\nМощность зарядки SMES: 100 МВт\\nПиковая мощность разрядки SMES: 2 000 МВт\\nПотребляемая мощность MPDG: 35 МВт\\nТепловая мощность MPDG: 0,75 ГВт\\nНоминальная мощность MPDG: 475 МВт\\nМасса: 7 500 кг\\nТип: гибрид MPDG / SMES\\nПроизводитель: Rusatom-Antonoff",
			"version_hash": 3759590889
		},
		"SYSTEM_IOE_AUX_HYBRID_MANUAL": {
			"string": "Вырабатывает много электроэнергии.\\nХранит большой запас электроэнергии.\\nПотребляет тепло.\\nПовреждение компьютера нарушает выработку, зарядку и разрядку.",
			"version_hash": 3764219210
		},
		"SHIP_MADCERF_CIV_INVERSE": {
			"string": "MAD-CERF (обратная гражданская переделка)",
			"version_hash": 1382038879
		},
		"SYSTEM_REACTOR_IOECERF": {
			"string": "Ядерный реактор MAD-CERF",
			"version_hash": 2167414238
		},
		"IOE_TUNE_PARAMETER_PRINT_AMMO_SPEED": {
			"string": "Скорость печати боеприпасов",
			"version_hash": 1211355364
		},
		"IOE_TUNE_PARAMETER_PRINT_DND_SPEED": {
			"string": "Скорость печати дронов",
			"version_hash": 1044549179
		},
		"SHIP_EIME_B": {
			"string": "Eon Interstellar Model B «Bubba»",
			"version_hash": 3626000883
		},
		"SHIP_EIME_B_SPECS": {
			"string": "Производитель: Eon Interstellar\\nВысокопрочные подвесы: 1\\nМалопрочные подвесы: 2\\nЭкипаж: 5\\nСухая масса: 27 240 кг\\nОбъём грузового отсека: 140 м³\\nХранилище переработанной руды (на каждый тип): 11 000 кг",
			"version_hash": 919535865
		},
		"SHIP_EIME_B_DESC": {
			"string": "Предшественник печально известной Model E — Model B по прозвищу «Bubba» — использовал надёжную схему двигателей кораблей серии K37. Первые испытания прошли успешно, но затем выяснилось, что компоновка неустойчива и создаёт нагрузки на реактор выше допустимых. Проект вернули на доработку и закрыли. Несколько кораблей сохранились у пилотов, которым нравилась свобода исходной конструкции и хватало мастерства справляться с её неустойчивостью.",
			"version_hash": 1810821042
		},
		"IOE_CREDITS_CONTRIBUTORS_ZAKRIN": {
			"string": "Za'krin — архитектура основного модуля и общая помощь с разработкой",
			"version_hash": 137382795
		},
		"IOE_CREDITS_CONTRIBUTORS_SPACEDOTEXE": {
			"string": "SpaceDOTexe — автор исходного мода и большей части его механик и содержимого",
			"version_hash": 2109346511
		},
