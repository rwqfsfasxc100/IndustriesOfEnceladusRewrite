		"SYSTEM_THRUSTER_PIN150": {
			"string": "Маневровий двигун RMS Pin-C50",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_PIN150_DESC": {
			"string": "Rasamama Material Solutions Pin-C50 - це унікальна твердотільна рушійна система, яка використовує імпульсну індукцію для прискорення і векторизації водневої плазми без використання будь-яких механічних компонентів, що значно мінімізує проблеми, пов'язані з пошкодженнями, які виникають при використанні звичайних рушіїв. Однак вони зазнають додаткового навантаження під час прискорення і виходять з ладу при значно нижчих прискореннях, ніж звичайні рушії. \n\nНезважаючи на неймовірну зносостійкість, встановлення важких плазмопроводів і допоміжної енергетичної інфраструктури, а також безпосереднє вбудовування рушіїв у корпус судна вимагає допомоги спеціалістів, яку може бути важко собі дозволити.",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_PIN150_SPECS": {
			"string": "Тяга: 150 kN \nШвидкість вихлопу: 90 км/c \nВитрата робочої маси: 1.6 кг/c \nЕнергоспоживання: 90 MW \nТеплоспоживання: 6.8 GW \nРежим роботи: Віртуално змінна тяга \nМаксимальне відхилення вектору тяги: 36 град \nРобоча маса: Воднева плазма \nМаса: 185 кг (на двигун) \nВиробник: Rasamama Material Solutions",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_BLAST": {
			"string": "Маневровий двигун ERS-BlasTR 7200",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_BLAST_DESC": {
			"string": "BlasTR від Electro Ride Systems - це повне відхилення від їхнього попереднього NAGHET, в якому використовується гвинтовий магнітоплазмодинамічний прискорювач для досягнення вражаючої тяги при настільки ж неймовірних швидкостях вихлопних газів. Першочергово призначена для гоночних суден, вона також зацікавила операторів важких суден, чиї високі вимоги до тяги довгий час не задовольнялися рушіями з низькою економічністю палива.",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_BLAST_SPECS": {
			"string": "Тяга: 450 kN \nШвидкість вихлопу: 22 км/c \nВитрата робочої маси: 20.5 кг/c \nЕнергоспоживання: 72 MW \nТеплоспоживання: 5.0 GW \nРежим роботи: Змінна тяга \nРобоча маса: Киснево-воднева плазма \nМаса: 145 кг (на двигун) \nВиробник: Electro Ride Systems",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_PNTRM": {
			"string": "Маневровий двигун ND-PNTRm",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_PNTRM_DESC": {
			"string": "Видатний успіх PNTR показав Nakamura Dynamics, що віковічну проблему делікатних шарнірних кріплень можна повністю обійти за допомогою твердотільної технології векторизації тяги, і компанія швидко приступила до роботи над ефективним зменшенням масштабу системи для використання в якості маневрових двигунів. \n\nНезважаючи на низьку швидкість вихлопу чистому вигляді, Імпульсний Ядерний Тепловий Двигун (мікро) компенсує це найбільшим ефективним діапазоном векторної тяги на сучасному ринку. Його низька експлуатаційна вартість і швидкий прогрів роблять його ідеальним для важчих кораблів з обмеженою конфігурацією маневрових двигунів",
			"version_hash": 0
		},
		"SYSTEM_THRUSTER_PNTRM_SPECS": {
			"string": "Тяга: 450 kN \nШвидкість вихлопу: 5 км/с \nВитрата робочої маси: 90.0 кг/с \nЕнергоспоживання: 40 MW \nТеплоспоживання: 1.8 GW \nРежим роботи: Імпульсна тяга \nМаксимальне відхилення вектору тяги: 60 град \nРобоча маса: Киснево-воднева плазма \nМаса: 25 кг (на двигун) \nВиробник: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_SALVAGE_ARM_HEAVY": {
			"string": "Rusatom-Antonoff ORD",
			"version_hash": 0
		},
		"SYSTEM_SALVAGE_ARM_HEAVY_DESC": {
			"string": "Протягом співпраці над KTA24 компанія Rusatom-Antonoff швидко визнала недоліки Triskellion-Armstrong AR-1500. Повільний і делікатний пристрій, який використовується як інструмент для видобутку руди, швидко зношує його точні сервоприводи і ретельно сконструйований докінг-адаптер. ORD - це їхня відповідь на ці недоліки. \n\nХоча він є особливо важким і енергоємним через свою громіздку опорну конструкцію, його зносостійкі двигуни і підшипники є життєздатною і довговічною альтернативою аналогам.",
			"version_hash": 0
		},
		"SYSTEM_SALVAGE_ARM_HEAVY_SPECS": {
			"string": "Сила руки: 3,200 kN \nДосяжність: 40 м \nЕнергоспоживання (пікове): 220 MW \nТочка кріплення: лише високоміцний підвіс \nМаса: 14,000 кг \nВиробник: Rusatom-Antonoff",
			"version_hash": 0
		},
		"SYSTEM_SALVAGE_ARM_LIGHT": {
			"string": "Runasimi KRB-500",
			"version_hash": 0
		},
		"SYSTEM_SALVAGE_ARM_LIGHT_DESC": {
			"string": "Маніпулятор проб Runasimi KRB-500 спочатку був розроблений для суден недостатньо фінансованих дослідницьких організацій, але нещодавно знайшов нову нішу в гірничій промисловості як зручна альтернатива системам нанодронів. \n\nПриводи маніпулятора використовують рідинні з'єднання з гальмівними дисками для імітації точності крокових або серво двигунів, що є новаторським рішенням, яке мінімізує витрати на обслуговування і загальну масу.  Крім того, його лапу можна намагнітити, щоб закріплювати на зовнішньому корпусі невеликі феромагнітні об'єкти, такі як корпуси дронів, але її міцність утримання може бути недостатньою для більших суден \n\nПримітка: набори для аналізу та експериментів купуються окремо.",
			"version_hash": 0
		},
		"SYSTEM_SALVAGE_ARM_LIGHT_SPECS": {
			"string": "Сила руки: 500 kN \nДосяжність: 35 м \nЕнергоспоживання (пікове): 60 MW \nМаса: 2,050 кг \nВиробник: Runasimi Inc.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_NANI": {
			"string": "Модернізація двигуна SSE NANI",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_NANI_DESC": {
			"string": "Цей комічно непрактичний і абсолютно огидний головний рушій є логічним завершенням багатьох ночей, проведених за випивкою та роздумами про мету життя. Прийшовши до висновку, що її немає, команда Sin Space Engineering зібралася з думками і створила цю річ. \n\nЗастереження: Omaewamou-Shindeiru вважає, що це дуже смішно і повністю схвалює використання NANI в якості рушія. Може анулювати гарантію на судно. Використання як головного двигуна в деяких судинах може пошкодити ваш реактор.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_NANI_SPECS": {
			"string": "Тяга: 3,450 kN \nШвидкість вихлопу: 132 км/c \nВитрата робочої маси: 0.5 кг/c \nЕнергоспоживання: 200 MW \nТеплоспоживання: 2 GW \nРобоча маса: Надкритична рідка уранова сіль \nЧас роботи: 1 хвилина (прибл.) \nМаса: 10,000 кг \nВиробник: Sin Space Engineering / Omaewamou-Shindeiru",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_GEMINI": {
			"string": "Подвійний двигун MA-NTR600-II ",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_GEMINI_DESC": {
			"string": "NTR600-II, також відомий як \"Gemini\", - це подвійний магнітоплазмодинамічний рушій, здатний забезпечити пристойну тягу з відмінною ефективністю і надійністю.  \n\nЗастереження:  технічне обслуговування цієї конструкції повинно виконуватися тільки інженерами Mitsudaya-Starbus або ліцензованими субпідрядниками. Страхові плани поки що недоступні у зовнішній сонячній системі.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_GEMINI_SPECS": {
			"string": "Тяга: 1,200 kN \nШвидкість вихлопу: 28 км/c \nВитрата робочої маси: 52 кг/c \nЕнергоспоживання: 250 MW \nТеплоспоживання: 16.8 GW \nМаксимальне відхилення вектору тяги: 60 град \nШвидкість зміни вектору тяги: 20 град/с \nРежим роботи: Змінна тяга \nРобоча маса: Воднева плазма \nМаса: 4,350 кг \nВиробник: Mitsudaya-Starbus",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_SOYUZ": {
			"string": "Четверний двигун RA-TNTRL-R44 ",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_SOYUZ_DESC": {
			"string": "Це вже не фантазія, що цей \"рушій\" існує. Rusatom-Antonoff мав на меті конкурувати з іншими багато-двигунними збірками, представивши свою власну, але розробка йшла повільно, і до кінця 22-го століття було випробувано багато прототипів, які зазнали невдачі, не знайшовши жодного життєздатного рішення. \n\nМіфи про процес його винайдення різняться, але загалом припускають, що провідного конструктора проекту відвідав уві сні привид легендарного радянського інженера-ракетобудівника Валентина Глушка. Він промовив одне слово \"Союз\", а потім пішов, залишивши маневровий двиген К44 біля ніг конструктора. \n\nВиробництво цих комбінованих двигунів триває і донині, і це одна з причин, чому рушій К44 все ще такий поширений.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_SOYUZ_SPECS": {
			"string": "Тяга: 1,600 kN \nШвидкість вихлопу: 15 км/c \nВитрата робочої маси: 106.4 кг/c \nЕнергоспоживання: 60 MW \nТеплоспоживання: 12.0 GW \nРежим роботи: Імпульсна тяга \nРобоча маса: Киснево-воднева плазма \nМаса: 650 кг \nВиробник: Rusatom-Antonoff",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_THUNDER": {
			"string": "Четверний двигун RA-K69V ",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_THUNDER_DESC": {
			"string": "Цей рушій - виготовлений на замовлення елемент обладнання, який використовує раму R44 і замінює його двигуни на двигуни K69V, в комплекті з кріпленнями карданного підвісу, якими ця лінійка так відома серед гонщиків кілець. Установку можна доповнити опціональною і повністю легальною модифікацією транспондера \"класу Thunderbarge\".",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_THUNDER_SPECS": {
			"string": "Тяга: 1,600 kN \nШвидкість вихлопу: 12 км/c \nВитрата робочої маси: 133.2 кг/c \nЕнергоспоживання: 100 MW \nТеплоспоживання: 14.4 GW \nРежим роботи: Імпульсна тяга, Змінний вектор тяги \nМаксимальне відхилення двигуна: 25 град \nШвидкість зміни вектору тяги: 360 град/c \nРобоча маса: Киснево-воднева плазма \nМаса: 950 кг \nВиробник: Custom-built / Rusatom-Antonoff",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_PIN1200": {
			"string": "Двигун RMS Pin-M200 ",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_PIN1200_DESC": {
			"string": "У двигуну Pin-M200 компанії Rasamama Material Solutions реалізована та сама технологія імпульсної індукції, що й у серії твердотільних маневрових двигунів Pin-150, але у більшому масштабі. Масштабування технології робить рушій більш крихким, проте його надійність все ще знаходиться в межах даних конкурентів. \n\nМасштабована технологія має теплоспоживання понад 60 ГВт безпосередньо від реактора. Враховуючи, що це випереджає навіть гоночні реактори, було вирішено включити мікротермоядерний реактор для живлення. На відміну від аналогічних термоядерних рушіїв, цей реактор використовується виключно для забезпечення тепла, а не є необхідним для створення тяги. Обмежений бак термоядерного палива обмежує час горіння приблизно до півтори години.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_PIN1200_SPECS": {
			"string": "Тяга: 1,200 kN \nШвидкість вихлопу: 105 км/c \nВитрата робочої маси: 11.4 кг/c \nЕнергоспоживання: 550 MW \nМаксимальне відхилення вектору тяги: 40 град \nРежим роботи: Змінна тяга \nРобоча маса: Воднева плазма / уранова сіль \nЧас горіння: 90 хвилин (прибл.) \nМаса: 11,350 кг \nВиробник: Rasamama Material Solutions",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_CRACK": {
			"string": "Двигун NDDFD",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_CRACK_DESC": {
			"string": "Двигун спрямованої термоядерної детонації від Nakamura Dynamics є одним з найпотужніших - і найперших! - термоядерних рушіїв, що досі існують на ринку. Популяризований тепер сумнозвісною рекламою 2214, що супроводжувалася піснею Vengaboys \"Boom, Boom, Boom, Boom\", NDDFD використовує потужні електромагніти для подрібнення перегрітих феромагнітних оболонок, що містять дейтерій і тритій під тиском, а потім спрямовує детонацію, що утворюється в результаті, назовні через сопло у вигляді клітки. \n\nНа відміну від свого конкурента, NDDFD потребує величезного і безперервного постачання енергії для підтримання тяги, а його відносно великі паливні таблетки і спеціалізоване обладнання подачі різко обмежують запас палива на малих суднах.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_CRACK_SPECS": {
			"string": "Тяга: 1,800 kN \nШвидкість вихлопу: 1,850 км/c \nВитрата робочої маси: 1 кг/c \nЕнергоспоживання: 445 MW \nРежим роботи: Імпульсна тяга \n Робоча маса: Воднева плазма \nТермоядерне паливо: D-T \nЧас роботи: 30 хвилин (прибл.) \nМаса: 4,650 кг \nВиробник: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_ZURBIN": {
			"string": "Двигун ND ZURBIN",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_ZURBIN_DESC": {
			"string": "Двигун Zurbin є високопродуктивним головним двигуном фрегатів класу \"Tsukuyomi\". Нині виведені з експлуатації, ці двигуни все ще використовуються на фрегатах, хоча часи їхньої участі в бойових діях давно минули. Nakamura Dynamics докладала зусиль для повторного використання двигунів зі списаних фрегатів, встановлюючи їх на автономних заправних станціях класу Phage.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_ZURBIN_SPECS": {
			"string": "Тяга: 6,900 kN \nШвидкість вихлопу: 66 км/с \nВитрата робочої маси: 104.5 кг/с \nЕнергоспоживання: 50 MW \nРежим роботи: Змінна тяга \nРобоча маса: Киснево-воднева плазма \nМаса: 10,000 кг \nВиробник: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_PMS": {
			"string": "Двигун ND PMS",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_PMS_DESC": {
			"string": "PMS є раннім попередником двигуна NTTR. Перший великий рушій типу NTR від Nakamura Dynamics має жахливу економію робочої маси та недостатню тягу для чистого NTR, але все ж відзначається своєю неймовірною надійністю. Здатний працювати під навантаженнями, що значно перевищують будь-які інші двигуни на ринку, і будучи неймовірно міцним для своєї потужності, PMS все ще затребуваний як двигун, здатний продовжувати роботу навіть у ситуаціях, які вважалися б критичними при використанні альтернатив.",
			"version_hash": 0
		},
		"SYSTEM_MAIN_ENGINE_PMS_SPECS": {
			"string": "Тяга: 3,000 kN \nШвидкість вихлопу: 3 км/с \nВитрата робочої маси: 1,000 кг/с \nЕнергоспоживання: 20 MW \nТеплоспоживання: 4.5 GW \nРежим роботи: Змінна тяга \nРобоча маса: Киснево-воднева плазма \nМаса: 250 кг \nВиробник: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM": {
			"string": "Направлена Микрохвильова Гармата RA",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_DESC": {
			"string": "Направлена Мікрохвильова Гармата від Rusatom-Antonoff використовує довгий трубчастий хвильовод для концентрації мікрохвиль в щільний промінь випромінювання. Його модульні і непрофільовані компоненти є дешевими і швидко ремонтуються, але це компенсується високими витратами на встановлення і середньою енергоефективністю.",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_SPECS": {
			"string": "Ефективна дальність: 800 м \nЕнергоспоживання: 120 MW \nВихідна потужність: 90 MW \nДовжина хвилі: 1 см \nМаса: 400 кг \nВиробник: Rusatom-Antonoff",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_PDT": {
			"string": "Направлена Микрохвильова Гармата RA на турелі",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_PDT_DESC": {
			"string": "Ця версія Направленої Мікрохвильової Гармати від Rusatom-Antonoff встановлена на корпус турелі Nakamura Dynamics NDPT. Вона має схожі характеристики керування і можливості налаштування параметрів конфігурації з їхньою лінійкою точкових оборонних турелей 42xx, хоча її гімбальний привід зменшено для належного керування важкими кабелями змінного струму. \n\nНМГ-турель може автоматично захоплювати і відстежувати цілі, але, на відміну від свого колеги рейкотрона, не потребує ручного керування для ведення вогню.",
			"version_hash": 0
		},
		"SYSTEM_MWTIGHTBEAM_PDT_SPECS": {
			"string": "Ефективна дальність: 800 м \nШІ наведення: Клас 1 \nЕнергоспоживання: 120 MW \nВихідна потужність: 90 MW \nДовжина хвилі: 1 см \nМаса: 3,000 кг \nВиробник: Rusatom",
			"version_hash": 0
		},
		"SYSTEM_PDTL": {
			"string": "Лазерна турель точкової оборони NDCL-80",
			"version_hash": 0
		},
		"SYSTEM_PDTL_MANUAL": {
			"string": "Автоматично вибирає цілі.\nВеде вогонь автоматично.\nКоординує в кількох системах.\nЦільовий комп'ютер недосконалий.\nВимкніть кріплення, щоб запобігти випадковому дружньому вогню.\nЗавдає термічну шкоду.",
			"version_hash": 0
		},
		"SYSTEM_PDTL_DESC": {
			"string": "Невеликий лазер, прикріплений до основи турелі, забезпечує широкий кут огляду з місця встановлення. Нижча потужність потребує трохи більше часу на руйнування каменів, проте це зменшує пошкодження по цілях. Він стріляє автоматично, тому користувачам рекомендується мати належний контроль над своїми системами IFF, щоб запобігти небажаним конфліктам. \n\nОБЛАДНАННЯ НАДАЄТЬСЯ «ЯК Є», БЕЗ БУДЬ-ЯКИХ ГАРАНТІЙ, ЯВНИХ ЧИ НЕЯВНИХ. КОРИСТУВАЧ БЕРЕ НА СЕБЕ ВСЮ ВІДПОВІДАЛЬНІСТЬ ЗА ВИКОРИСТАННЯ ЦЬОГО ОБЛАДНАННЯ.",
			"version_hash": 0
		},
		"SYSTEM_PDTL_SPECS": {
			"string": "Ефективна дальність: 1,000 м \nШІ наведення: Клас 1 \nЕнергоспоживання (пікове): 80 MW \nМаса: 1,500 кг \nВиробник: Nakamura Dynamics, Coherent Light",
			"version_hash": 0
		}
	},
	"zh_CN": {
		"SYSTEM_CARGO_AUX_FAB": {
			"string": "SSE旅行者级制造单元",
			"version_hash": 3275038314
		},
		"SYSTEM_CARGO_AUX_FAB_DESC": {
			"string": "一台由辛空间工程定制的、完全未经授权的怪物装置，在2260年代于环带矿工中深受喜爱。旅行者RSLS MPU的制造单元被拆除，并重新安置到货舱更靠前的位置，同时配备了一个小型矿物储存空间，以取代其专用的进料斗。 \n\n由于其电源总线被替换为低级分配器，预计与标准单元相比，会有中等程度的功率效率损失。 \n\n免责声明：中村动力公司对本设备不提供任何保修服务，也不明示或暗示其属于公司产品系列。使用改装设备可能会造成损害并带来意外危险。",
			"version_hash": 2811765356
		},
		"SYSTEM_CARGO_AUX_FAB_SPECS": {
			"string": "打印功耗：120 MW\n打印能力：无人机、弹药\n弹药打印速度：2.5 kg/s\n无人机打印速度：7.14 kg/s\n载货量：2000 kg/矿物（总计12000 kg）\n推进剂容量：6000 kg\nMPU处理速度变化：MPU标称速度的155%\n质量：5000 kg\n制造商：SSE-中村-友邦拓",
			"version_hash": 571134218
		},
		"SYSTEM_CARGO_AUX_FAB_MANUAL": {
			"string": "需要MPU才能正常使用。 \n被动增加舰载成品矿物和推进剂的储量。 \n成品矿物被储存在单独的容器中，每种矿物的容量有限。 \n以一定倍率提高MPU速度。 \n改变了MPU对每个矿块的处理速度和功耗。\n以铁（Fe）与钒（V）9:1的比例生产动能弹药。 \n以铁（Fe）与铂（Pt）4:1的比例生产纳米无人机组件。 \n占用部分货舱空间。",
			"version_hash": 783944584
		},
		"SYSTEM_CARGO_AUX_BIGFAB": {
			"string": "RMS-PAL制造单元",
			"version_hash": 1206647390
		},
		"SYSTEM_CARGO_AUX_BIGFAB_DESC": {
			"string": "拉萨玛玛材料解决方案的便携式装配线堪称自动化的奇迹，它融合了两个1级人工智能（阿尔忒弥斯和阿波罗）以对抗关系监督彼此的工作。其卓越的生产速度完全得益于两者不断的情境优化，且其大型出料斗可与船舶内部弹药库相连，作为额外的弹药存储单元。\n\n免责声明：人工智能规格符合2184年《洛杉矶公约》的1级分类标准。阿尔忒弥斯和阿波罗均不具备感知或沟通能力。如发现任何异常行为，请立即向ATLAS报告。 ",
			"version_hash": 3039338460
		},
		"SYSTEM_CARGO_AUX_BIGFAB_SPECS": {
			"string": "打印功耗：210 MW\n打印能力：无人机、弹药\n弹药打印速度：5.56 kg/s\n无人机打印速度：20 kg/s\n弹药储量：5000 kg\n无人机储量：5000 kg\n质量：10500 kg\n制造商：拉萨玛玛材料解决方案",
			"version_hash": 441347358
		},
		"SYSTEM_CARGO_AUX_BIGFAB_MANUAL": {
			"string": "需要MPU才能正常使用。 \n被动增加舰载弹药和纳米无人机的储量。 \n以铁（Fe）与钒（V）9:1的比例生产动能弹药。 \n以铁（Fe）与铂（Pt）4:1的比例生产纳米无人机组件。 \n占用部分货舱空间。",
			"version_hash": 1621372241
		},
		"SYSTEM_CARGO_MPU_FURN": {
			"string": "俄原-安东诺夫MPU Mk2",
			"version_hash": 2471399476
		},
		"SYSTEM_CARGO_MPU_FURN_DESC": {
			"string": "这款由俄罗斯国家原子能与安东诺夫公司联合研发的矿物处理单元Mark-2型变体，被矿场工人亲切地称为“嗜吞者”，它结合了前代产品的优良品质，并增加了进料口护套和额外的加热元件，以降低作业范围为代价，提高了整体效率和回收率。",
			"version_hash": 2643942531
		},
		"SYSTEM_CARGO_MPU_FURN_SPECS": {
			"string": "处理能力：25 kg/s\n功耗：25 MW/块\n矿物处理效率：60%\n反作用质量提取效率：40%\n质量：3000 kg\n制造商：俄原-安东诺夫",
			"version_hash": 3043746311
		},
		"SYSTEM_CARGO_MPU_BULK": {
			"string": "泰坦重工“深空巨舰”MPU",
			"version_hash": 2229332609
		},
		"SYSTEM_CARGO_MPU_BULK_DESC": {
			"string": "泰坦重工的“深空巨舰”MPU于2200年代中叶推向市场，但在2260年代签订贸易协议后，才开始在土卫二矿工中流通。其干净的设计是泰坦重工“简洁即美”工程理念的经典体现。\n\n与其他MPU相比，“深空巨舰”安装起来沉重且笨拙，但其独特之处在于内置的存储能力。一台THI-CC无人机的内部结构被整合在处理区下方；虽然料仓尺寸有所减小，但仍能显著提高所安装船舶的矿物运输能力。",
			"version_hash": 3962860489
		},
		"SYSTEM_CARGO_MPU_BULK_SPECS": {
			"string": "载货量：10000 kg/矿物（总计60000 kg）\n处理能力：40 kg/s\n功耗：100 MW/块\n矿物处理效率：70%\n反作用质量提取效率：20%\n质量：8000 kg\n制造商：泰坦重工",
			"version_hash": 262388787
		},
		"SYSTEM_CARGO_AUX_PREPROC_0x30": {
			"string": "拉萨玛玛RP-25",
			"version_hash": 2391507102
		},
		"SYSTEM_CARGO_AUX_PREPROC_0x30_DESC": {
			"string": "拉萨玛玛材料解决方案 RP-25是一款不起眼的矿石预处理器，专为在船舶货舱内熔化矿物块中的冰而设计，几乎不涉及其他功能。该装置利用反应堆涡轮机排放管线的热能，且运行所需电能极少。 \n\n反作用工质通过安装在船体上的冷凝器-散热器面板进行回收。拉萨玛玛材料解决方案建议每月进行流量测试，然后使用热气吹扫，以防止结垢。",
			"version_hash": 2781581084
		},
		"SYSTEM_CARGO_AUX_PREPROC_0x30_SPECS": {
			"string": "融冰速率：22.5 kg/s\n预处理反作用工质提取效率：45%\n预处理功耗：1000 KW/矿块\n矿块同时处理数量上限：10\nMPU处理速度变化：-10 kg/s\n\n质量：750 kg\n制造商：拉萨玛玛材料解决方案",
			"version_hash": 266170427
		},
		"SYSTEM_CARGO_AUX_PREPROC_20x10": {
			"string": "NDBMT",
			"version_hash": 229172282
		},
		"SYSTEM_CARGO_AUX_PREPROC_20x10_DESC": {
			"string": "中村动力的大型矿石预处理器在处理矿石块时，充分利用其基本工作原理。货舱内的自由蒸汽被该设备的大型环形散热器过热，从而快速升华水冰，并预热由此产生的金属颗粒，以实现更高效的加工。 \n\n虽然部分工艺蒸汽可以作为推进剂回收，但该装置的紧凑型冷凝器往往因体积庞大和温度过高而超负荷。 \n\n免责声明：没有任何脑叶切除者在本装置的研发过程中受到伤害。",
			"version_hash": 1452141553
		},
		"SYSTEM_CARGO_AUX_PREPROC_20x10_SPECS": {
			"string": "融冰速率：25 kg/s\n预处理反作用工质提取效率：25%\n预处理功耗：750 KW/矿块\n矿块同时处理数量上限：7\nMPU矿物处理效率乘数：x115%\nMPU处理速度变化：MPU标称速度的90%\n质量：2000千克\n制造商：中村动力",
			"version_hash": 2292237463
		},
		"SYSTEM_CARGO_AUX_PREPROC_40x20": {
			"string": "俄原-安东诺夫MPP-N1",
			"version_hash": 2547585297
		},
		"SYSTEM_CARGO_AUX_PREPROC_40x20_DESC": {
			"string": "MPP-N1是市场上最优秀的矿物预处理设备之一，凭借其磁流体动力学系统，在效率提升和推进剂回收率方面表现出色。\n\n该装置将反应堆动力装置的废气作为其热源，通过其中心的加热泡将其排放到货仓中。加热泡周围的电磁线圈通过感应加热来控制温度。 \n\n加工蒸汽和微量矿物通过带挡板的冷凝器进行回收。为确保最高效率，建议在飞行320小时后更换冷凝器组件。",
			"version_hash": 663972734
		},
		"SYSTEM_CARGO_AUX_PREPROC_40x20_SPECS": {
			"string": "融冰速率：10 kg/s\n预处理反作用工质提取效率：20%\n预处理功耗：375 KW/矿块\n矿块同时处理数量上限：5\nMPU矿物处理效率乘数：x135%\nMPU处理速度变化：MPU标称速度的80%\n质量：6500 kg\n制造商：俄原-安东诺夫",
			"version_hash": 3897150114
		},
		"SYSTEM_CARGO_PREPROC_P15": {
			"string": "俄原矿物切割机",
			"version_hash": 3627447616
		},
		"SYSTEM_CARGO_PREPROC_P15_DESC": {
			"string": "RCC是在货仓改造技术的早期阶段制造出来的，与当时的大多数公司不同，它专注于将矿石送入处理器的能力，而非矿石从处理器中输出的效率。通过处理器中的点火激光器点燃一层均匀但精细的镁涂层，人为地使水熔化，从而缩短了矿块通过处理器的耗时。点火产生的额外热量会进一步地轻微熔化矿块，但过程中产生的大量杂质使其不适合用于推进剂回收。 \n\n镁粉可在土卫二主站免费补充。",
			"version_hash": 3900349306
		},
		"SYSTEM_CARGO_PREPROC_P15_SPECS": {
			"string": "融冰速率：17.5 kg/s\n预处理功耗：50 KW/矿块\nMPU处理速度变化：+25 kg/s\n矿块同时处理数量上限：12\n质量：1220 kg\n制造商：俄罗斯国家原子能",
			"version_hash": 549556827
		},
		"SYSTEM_CARGO_AUX_PREPROC_SPEED_ADD_MANUAL": {
			"string": "减少大范围内矿块的冰质量。\n以一定数值提高MPU的速度。\n当通电时，货舱内的矿块含水量减少。\n功率需求和处理速度取决于矿块数量。\n不会提取矿物或破坏矿块。\n占用货舱内的部分空间。",
			"version_hash": 709281800
		},
		"SYSTEM_CARGO_PREPROC_M35": {
			"string": "MAD加热线圈",
			"version_hash": 378451025
		},
		"SYSTEM_CARGO_PREPROC_M35_DESC": {
			"string": "这个专用处理单元利用进入槽内的矿石块进行解构性熔化，从而形成更易碎的冰结构。该单元还配备了一个辅助效率单元，可直接捆绑在MPU单元上，以提高处理速度和矿物回收率。 \n\n该设备确实收到了来自长期使用它的公司的大量批评，因为其专有组件在使用几个月后就会迅速分解失效。",
			"version_hash": 2940725549
		},
		"SYSTEM_CARGO_PREPROC_M35_SPECS": {
			"string": "融冰速率：12.5 kg/s\n预处理反作用工质提取效率：20%\n预处理功耗：550 KW/矿块\nMPU处理速度变化：MPU标称速度的135%\n次级MPU处理速度修正：10 kg/s\n矿块同时处理数量上限：7\nMPU矿物处理效率乘数：x110%\n质量：4780 kg\n制造商：机器星际动力公司",
			"version_hash": 2475637041
		},
		"SYSTEM_CARGO_AUX_PREPROC_SPEED_ADD_AND_MULTI_MANUAL": {
			"string": "减少大范围内矿块的冰质量。\n补充推进剂。\n以一定倍率提高MPU的效率。\n以一定倍率和数值提高MPU的速度。\n同时处理多个矿块。\n功率需求和处理速度取决于矿块数量。\n不会提取矿物或破坏矿块。\n占用货舱内的部分空间。",
			"version_hash": 2275502767
		},
		"SYSTEM_CARGO_PREPROC_M85": {
			"string": "MS外套层",
			"version_hash": 3604956203
		},
		"SYSTEM_CARGO_PREPROC_M85_DESC": {
			"string": "光田-星际客车的外套层结合了高性能线圈与模式识别芯片，以优化冰层的融化与穿透。模式识别AI芯片的使用源自 21 世纪初大语言模型算法盛行时期的一种地质勘探方法；该技术通过观察来确定一种在矿物损失不超过基础单元的情况下，最优地破碎矿石的方法。使用此装置会带来巨大的电力成本，因为每个矿石块在扫描区域内的全程跟踪都会产生额外的电力消耗。 \n\n后续的设备采用了专用的熔化激光器，以进一步提高加工效率，这与预处理器设备上所使用的激光器类似。虽然每个矿块产生的功耗远高于其他设备，但其处理能力无与伦比，并且相较于其他商用设备，能进一步降低矿石中的水分含量。",
			"version_hash": 3954154303
		},
		"SYSTEM_CARGO_PREPROC_M85_SPECS": {
			"string": "MPU处理速度系数：MPU速度的185%\n融冰速率：35 kg/s\n预处理功耗：12.5 MW/矿块\n矿块同时处理数量上限：20\n管理AI：1级\n质量：12550 kg\n制造商：光田-星际客车",
			"version_hash": 4053516819
		},
		"SYSTEM_CARGO_AUX_PREPROC_SPEED_MULTI_MANUAL": {
			"string": "减少大范围内矿块的冰质量。\n以一定倍率提高MPU的速度。\n当通电时，货舱内矿块的含水量减少。\n功率需求和处理速度取决于矿块数量。\n不会提取矿物或破坏矿块。\n占用货舱内的部分空间。",
			"version_hash": 3157397034
		},
		"SYSTEM_CARGO_AUX_PREPROC_MANUAL": {
			"string": "减少大范围内矿块的冰质量。\n补充推进剂。\n以一定倍率提高MPU的效率。\n以一定倍率降低MPU的速度。\n同时处理多个矿块。\n功率需求和处理速度取决于矿块数量。\n更改了每个矿块的MPU处理速度和功耗。\n不会提取矿物或破坏矿块。\n占用货舱内的部分空间。",
			"version_hash": 3525517822
		},
		"SYSTEM_CARGO_AUX_PREPROC_NOMINERAL_MANUAL": {
			"string": "减少大范围内矿块的冰质量。\n补充推进剂。\n同时处理多个矿块。\n功率需求和处理速度取决于矿块数量。\n更改了每个矿物块的MPU处理速度和功耗。\n不会提取矿物或破坏矿块。\n占用货舱内部分空间。",
			"version_hash": 2478441497
		},
		"SYSTEM_CARGO_AUX_STORAGE_4K": {
			"string": "康列多内部存储架",
			"version_hash": 3133945664
		},
		"SYSTEM_CARGO_AUX_STORAGE_4K_DESC": {
			"string": "康列多RVM内部存储架在22世纪初经过小行星带矿工的反复试验和测试，其设计理念相对简单，但执行过程却颇为复杂。这款模块化改装套件可将现有装置连接到市场上大多数大型船只的加工物料线上 \n\n额外的微型货舱最初是第三方加装的，但由于其极高的受欢迎程度，康列多毫不掩饰地将其融入了基础型号。",
			"version_hash": 3406312981
		},
		"SYSTEM_CARGO_AUX_STORAGE_4K_SPECS": {
			"string": "载货量：4000 kg/矿物（总计24000 kg）\n弹药储量：3000 kg\n无人机储量：3000 kg\n推进剂储量：5000 kg\n质量：3000 kg\n制造商：康列多RVM",
			"version_hash": 979951095
		},
		"SYSTEM_CARGO_AUX_STORAGE_MANUAL": {
			"string": "需要MPU才能正常使用。\n被动增加舰载成品矿物容量。\n成品矿物储存在独立容器中，每种矿物的容量有限。\n占用货舱内的部分空间。\n不需要供电或反应堆热量。",
			"version_hash": 1109945275
		},
		"SYSTEM_CARGO_AUX_STORPROC_8K": {
			"string": "THI矿物储罐模组",
			"version_hash": 3193540710
		},
		"SYSTEM_CARGO_AUX_STORPROC_8K_DESC": {
			"string": "泰坦重工的内部存储解决方案既新颖又颇具实验性。通过利用来自飞船散热器的反应堆热量，处理后的材料可以无限期地保持液态，从而使存储效率提高多达20%。 \n\n一些矿工已开始将该装置用作初级矿石预处理器，因为相对较薄的隔热层会向储罐之间的空间散热。泰坦重工并不认可也不建议这种使用方式。",
			"version_hash": 3863630450
		},
		"SYSTEM_CARGO_AUX_STORPROC_8K_SPECS": {
			"string": "载货量：8000 kg/矿物（总计48000 kg）\n融冰速率：5 kg/s\n预处理反作用工质提取效率：15%\n预处理功耗：250 KW/矿块\nMPU处理速度变化：MPU标称速度的110%\n矿块同时处理数量上限：8\n质量：8000 kg\n制造商：泰坦重工",
			"version_hash": 1192052042
		},
		"SYSTEM_CARGO_AUX_STORPROC_MANUAL": {
			"string": "需要MPU才能正常使用。\n被动增加舰载成品矿物容量。\n成品矿物储存在独立容器中，每种矿物的容量有限。\n减少小范围内矿块的冰质量。\n更改了每个矿块的MPU处理速度和功耗。\n补充推进剂。\n占用货舱内的部分空间。",
			"version_hash": 2664281654
		},
		"SYSTEM_CARGO_AUX_STORAGE_12K": {
			"string": "MPI漫游式筒仓",
			"version_hash": 286773463
		},
		"SYSTEM_CARGO_AUX_STORAGE_12K_DESC": {
			"string": "MPI漫游式筒仓是迄今为止最大的",
			"version_hash": 2200710843
		},
		"SYSTEM_AMMO_200": {
			"string": "投射物弹匣",
			"version_hash": 4122866846
		},
		"SYSTEM_AMMO_200_DESC": {
			"string": "一套用于动能投射物武器的扩展导轨，能够处理各种口径的弹药。弹药由经济高效的齿轮齿条式执行器供给。其底部的端口支持手动和自动装填。",
			"version_hash": 3564362393
		},
		"SYSTEM_AMMO_200_SPECS": {
			"string": "存储：200 kg\n输送：100 kg/s\n制造商：拉萨玛玛材料解决方案",
			"version_hash": 1728307928
		},
		"SYSTEM_AMMO_100000": {
			"string": "船坞级弹药库",
			"version_hash": 3522335561
		},
		"SYSTEM_AMMO_100000_DESC": {
			"string": "该模块通常置于补给场，主要制造目的是在供应无法满足需求时提供大量投射器弹药。若技术熟练，该装置可被改装至超重型舰船上，用于通常持续数周的作战行动。",
			"version_hash": 551948646
		},
		"SYSTEM_AMMO_100000_SPECS": {
			"string": "存储：100000 kg\n输送：1000 kg/s\n制造商：中村动力",
			"version_hash": 534276821
		},
		"SYSTEM_DND_100000": {
			"string": "船坞级纳米无人机储存",
			"version_hash": 3696801861
		},
		"SYSTEM_DND_100000_DESC": {
			"string": "这种存储单元最常配备于环内空间站，其容量足够大，可在缺乏补给时提供充足的纳米无人机供应。也可配备于超重型船舶上，用于工业应用。",
			"version_hash": 35071661
		},
		"SYSTEM_DND_100000_SPECS": {
			"string": "存储：100,000 kg\n输送：100 kg/s\n制造商：中村动力",
			"version_hash": 3544326521
		},
		"SLOT_CREW_MOD": {
			"string": "居住站套件",
			"version_hash": 1106608157
		},
		"HUD_CREW_QUALITY": {
			"string": "居住站质量改装",
			"version_hash": 818688299
		},
		"SYSTEM_CREW_ADD_BUNK": {
			"string": "康列多双层床X1",
			"version_hash": 1778006662
		},
		"SYSTEM_CREW_ADD_BUNK_DESC": {
			"string": "这是市面上能买到的最简单、最便宜的船员住宿扩展套件，该套件包括一个贴墙安装的双层床，采用记忆海绵床垫，配有基本的织物罩和防火绝缘材料。其舒适度令人惊讶，但缺乏私人空间肯定会成为船员之间争论的焦点 。\n\n土卫二空间站控制中心提醒各位船长，根据规定，在计划进入环区的巡航时长内，每位船员至少需携带三倍于配额的物资。若未能遵守此规定，可能会受到相关监管机构的罚款。",
			"version_hash": 3010839357
		},
		"SYSTEM_CREW_ADD_BUNK_SPECS": {
			"string": "乘员容量：+1\n乘员每日士气下降：+30%（极差）\n质量：250 kg\n每位乘员增加质量：15 kg\n制造商：康列多RVM",
			"version_hash": 3302638490
		},
		"SYSTEM_CREW_ADD_BUNK2": {
			"string": "康列多双层床X2",
			"version_hash": 1778006663
		},
		"SYSTEM_CREW_ADD_BUNK2_DESC": {
			"string": "一模一样，再来一个！双层床X2本质上就是两个双层床X1，以更高效的配置安装，但它的好处就到此为止了。 \n\n大多数潜在雇员在船上看到一个，就会望而却步，更不用说两个了。尽管如此，它们无疑是增加船员容量的一个选择，并且经常被小型月间运输船大量使用，因为这些船更看重容量和便利性，而非乘客的舒适度。",
			"version_hash": 913173296
		},
		"SYSTEM_CREW_ADD_BUNK2_SPECS": {
			"string": "乘员容量：+2\n乘员每日士气下降：+40%（极差）\n质量：500 kg\n每位乘员增加质量：35 kg\n制造商：康列多RVM",
			"version_hash": 2669481436
		},
		"SYSTEM_CREW_ADD_CAPSULE": {
			"string": "鲁纳斯米居住舱",
			"version_hash": 659907056
		},
		"SYSTEM_CREW_ADD_CAPSULE_DESC": {
			"string": "鲁纳斯米在船员居住市场上一直是低端酒店市场中的主流产品，由一个轻便、耐压的模块组成，内部设有两张胶囊床、一个基本的套间式卫生间，以及用于存放船员物品和给养的储物空间。内部氧气储罐和压力服架确保在非工作时间的船体破裂不会立即导致船员失去行动能力。 \n\n压力服需单独购买。请定期检查储气罐压力，并至少每周按照手册中的说明进行一次密封性检查。鲁纳斯米公司对因设备维护不当而造成的损坏不承担责任。",
			"version_hash": 4278800497
		},
		"SYSTEM_CREW_ADD_CAPSULE_SPECS": {
			"string": "乘员容量：+2\n乘员每日士气下降：+25%（差）\n质量：1000 kg\n每名乘员增加质量：60 kg\n制造商：鲁纳斯米公司",
			"version_hash": 746481602
		},
		"SYSTEM_CREW_ADD_MANUAL": {
			"string": "增加或减少总乘员容量。  \n增加或减少运行时的每日乘员士气下降。  \n不快乐的乘员可能导致更差的操作结果。  \n不需要功率或反应堆热量。",
			"version_hash": 1498043543
		},
		"SYSTEM_CREW_MOD_HOME": {
			"string": "康列多“微重力之家”套件",
			"version_hash": 512073234
		},
		"SYSTEM_CREW_MOD_HOME_DESC": {
			"string": "康列多的“微重力之家”套件是一款面向家庭船只和轻型运输船的简易模块化套件。它包括一个供船员宿舍使用的共享多通道娱乐系统、厨房中的冰箱和改进型食品加工单元，以及对洗手间的几处调整，如多模式淋浴头和记忆海绵马桶坐垫。 \n\n注意：淋浴喷头的喷雾模式不适合在零重力环境下使用。为达到最佳效果，请勿使用含次氯酸的清洁剂清洗表面或坐垫。",
			"version_hash": 1541538016
		},
		"SYSTEM_CREW_MOD_HOME_SPECS": {
			"string": "乘员每日士气下降：-10%（良好）\n质量：200 kg\n每名乘员增加质量：75 kg\n制造商：康列多RVM",
			"version_hash": 484209855
		},
		"SYSTEM_CREW_MOD_KMX": {
			"string": "安东诺夫KMX升级套件",
			"version_hash": 1009235224
		},
		"SYSTEM_CREW_MOD_KMX_DESC": {
			"string": "安东诺夫KMX被宣传为一种长期飞行舒适系统，专为月间货运机组和客运飞船设计。 \n\n它配备一套完整的水回收系统，对厨房、盥洗室和休闲甲板进行了一系列改进（并且适用于在大多数常见船体构型上安装，若其构型尚未具备这些设施），以及为大多数标准座椅提供座椅通风，机组人员通常认为，与没有这些设施的飞行相比，装备KMX升级版的飞行体验更佳。",
			"version_hash": 634832562
		},
		"SYSTEM_CREW_MOD_KMX_SPECS": {
			"string": "乘员容量：-1\n乘员每日士气下降：-20%（良好）\n质量：500 kg\n每名乘员增加质量：150 kg\n制造商：安东诺夫",
			"version_hash": 590740684
		},
		"SYSTEM_CREW_MOD_OCM": {
			"string": "OCM-36升级套件",
			"version_hash": 2866422882
		},
		"SYSTEM_CREW_MOD_OCM_DESC": {
			"string": "友邦拓微型工程的OCM-36彻底改造了船上居住环境，引入了现代化的豪华配置，让那些曾参观或居住在其空间站中的人倍感亲切。此次购买涵盖了友邦拓（或其他获得许可的）翻新商的全部劳动力成本，其中包括使用中村动力的2级AI系统来优化不同的内部几何结构。 \n\n如果配备可调节寝具、独立娱乐系统和独立浴室的独立船员舱还无法满足需求，那么厨房里配备的全套大和品牌料理台、丰富多样且宽敞的娱乐区，以及经过全面翻新的现代时尚驾驶舱——更不用说令人愉悦的墙面覆层和用于零重力行动的低矮扶手了——定能满足您的需求。",
			"version_hash": 3448327638
		},
		"SYSTEM_CREW_MOD_OCM_SPECS": {
			"string": "乘员容量：-2\n乘员每日士气下降：-50%（极佳）\n质量：700 kg\n每名乘员增加重量：200 kg\n制造商：友邦拓微工程",
			"version_hash": 4045491044
		},
		"SYSTEM_CREW_MOD_MANUAL": {
			"string": "提高或降低行动中时的乘员每日士气下降。\n士气低落的乘员可能导致更差的操作结果。\n不需要功率或反应堆热量。",
			"version_hash": 1090907183
		},
		"SYSTEM_DND_HARVTUG": {
			"string": "OT强力截停无人机",
			"version_hash": 3769092629
		},
		"SYSTEM_DND_HARVTUG_DESC": {
			"string": "友邦拓-泰坦强力截停纳米无人机投放系统是THI收割者级系统的改进版，其配置旨在使高反射率物体相对于环带实现柔和制动。该系统最初是为OCP-209制造的专有设备，用于损失控制，自2260年代签订商业协议后，已在售后市场上流通。",
			"version_hash": 888894848
		},
		"SYSTEM_DND_HARVTUG_SPECS": {
			"string": "功耗：120 MW\n有效范围：800米（视线内）\n无人机发射能力：100 架/秒\n无人机湿质量：0.1 kg\n推力：1 kN（每架无人机）\n质量：8000 kg\n制造商：友邦拓-泰坦",
			"version_hash": 3178522476
		},
		"SYSTEM_DND_HARVHAUL": {
			"string": "THI收割者级牵引无人机",
			"version_hash": 2881376406
		},
		"SYSTEM_DND_HARVHAUL_DESC": {
			"string": "这个庞大的硬件伪装成一次性纳米无人机组装器，但其实是一条工业流水线。其巨大的红外激光阵列和制造单元连接到各个低应力总线上，但当它获得足够能量时，其威力将令人叹为观止。该单元会引导无人机拦截任何高反射率物体，并将其拖向你的飞船。",
			"version_hash": 1989403555
		},
		"SYSTEM_DND_HARVHAUL_SPECS": {
			"string": "功耗：120 MW\n有效范围：800 m（视线内）\n无人机发射能力：100 架/秒\n无人机湿质量：0.1 kg\n推力：1 kN（每架无人机）\n质量：8000 kg\n制造商：泰坦重工",
			"version_hash": 3675108725
		},
		"SYSTEM_EXODYN": {
			"string": "THI动态货物集装箱",
			"version_hash": 4041067218
		},
		"SYSTEM_EXODYN_DESC": {
			"string": "THI货运集装箱的实验性动态变体，于2200年代中期向公众发布。需要现场矿物处理单元才能使用。购买货运吊篮设备时，会附带一份租赁协议，只要所有者持有许可证，就会持续提供新的吊舱。 \n\nDyna-Cargo商标为泰坦重工版权所有。土卫二空间站控制中心警告称，使用某些RCS配置进行改装可能会使集装箱的微型反应堆过热，船长需承担所有相关责任。",
			"version_hash": 2045859745
		},
		"SYSTEM_EXODYN_SPECS": {
			"string": "载货量：72000 kg（合计）\n功率（标称）：20 MW\n支架质量：500 kg\n制造商：泰坦重工",
			"version_hash": 2179654831
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_TWIN": {
			"string": "友邦拓七号的一些建筑工人把他们的一艘双引擎施工船落在了外面，却没注意到它被“收走”了。这艘船对我们来说太笨重了，你可以出价50万买下它。",
			"version_hash": 2044666062
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_PEEPER": {
			"string": "我们这里有一台有史以来最奇特的机器；一台OCK窥视器。它甚至比OK720还要笨重，售价25万。",
			"version_hash": 1543415986
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_CK65": {
			"string": "我这里正好有一艘勘探者级货船待售。虽然货舱很小，但巨大的居住区和加工存储空间绝对值得。只需20万，它就是你的了！",
			"version_hash": 781928573
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_CK69": {
			"string": "我这里正好有一艘勘探者级货船待售。虽然货舱很小，但巨大的居住区和加工存储空间绝对值得，甚至还配备了可变改造设施。只需25万，它就是你的了！",
			"version_hash": 275405634
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_YME": {
			"string": "我们对埃隆星际在此地游荡的行为表示强烈不满，他们的一些无良员工试图将“奢侈”带给那些负担不起他们那荒谬价格的人。45万，所有部件均打包出售。",
			"version_hash": 742483696
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_OCP_SALVAGE": {
			"string": "那好，如果你想购买辛空间工程留下来的零件，这个精简版的OCP就归你了。没有货舱，但有一个机械臂，能帮你把他们别处的烂摊子也一并带回来。只需40万，全部归你。",
			"version_hash": 1988345572
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_TSUKUYOMI": {
			"string": "我们发现了一艘非常旧的月读级护卫舰。它已经破败不堪，实际上大概也就值个废铁价，但船体结构仍然完好无损。不管怎样，它都是一艘巨型战舰，所以我们出价七百五十亿。",
			"version_hash": 803594382
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_STUB": {
			"string": "我手头有一辆短款泰坦变体。上面装备了不少好东西，但可选装的配置非常奇怪。报价90万。",
			"version_hash": 483749210
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_ATLAS": {
			"string": "我们给那些封存的ATLAS边缘行者飞船搞了个实验性改装。基本上就是把一个救生舱和一些杂七杂八的东西绑上去，以便让一组船员能驾驶它。我不知道这合法不合法，但给个40万就归你了。",
			"version_hash": 3893770970
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_COTHON_LUX": {
			"string": "我们仓库里有一艘高级科松飞船。它在大多数方面都比旧设计有了很大改进，所以我们打算在为该系列船只提供的常规价格基础上再加点价。全套25万。",
			"version_hash": 2514839995
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_PIDGEON": {
			"string": "我们这里有一架勘探鸽。基本上是勘探秃鹫的加长货仓型变体，具备勘探鹈鹕所提供的所有功能。只需55万即可拥有。",
			"version_hash": 3035471607
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_CERF": {
			"string": "离这里不远的地方有一艘民用改装过的MAD-CERF搜救船。它缺少一些常规功能，并且为了提供更多的采矿能力，换掉了居住区和挂载点，这让它对我们来说有点不太合适。所以，如果你感兴趣的话，我们愿意以80万的价格卖给你。",
			"version_hash": 1082177044
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_OBERON": {
			"string": "我们找到了一艘高性能的赛艇。尽管部分部件受损严重，但这艘船竟然奇迹般地保持着完整，风采依旧。整艘船只要一百万。",
			"version_hash": 3345150729
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_DEEP_DISH": {
			"string": "这艘工程船经过采矿改装。基本上只是在原有的基础上增加了一些功能，让采矿作业稍微容易一些，所以对我们来说并不是特别有用。50万，这艘船就归你了。",
			"version_hash": 2881377596
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_SNAP": {
			"string": "我拿到了一艘OCP建造平台的早期版本。它的货仓门是两扇对开，而不是量产型的单扇货仓门，这使得它的门洞更加居中。固件甚至还带有20世纪末电子游戏中的音效。这艘船售价50万。",
			"version_hash": 1554913461
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_OK720": {
			"string": "有个挺怪异的项目船，把一个OCP货舱给焊到了一艘失败的K44型船体上。基本上就是给其中一艘装了个巨大的货舱。全套下来要30万。",
			"version_hash": 254975921
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_RAM": {
			"string": "我对K37进行了民用改装，使其具备了勘探者级的多项功能。非常强大，非常适合采矿，但驾驶起来有点不舒服。这艘船售价25万。",
			"version_hash": 2237712289
		},
		"SLOT_CARGOBAY_MOD": {
			"string": "矿物储存套件",
			"version_hash": 1868469807
		},
		"SYSTEM_CARGO_MOD_2K": {
			"string": "SSE鞍袋",
			"version_hash": 2894760378
		},
		"SYSTEM_CARGO_MOD_2K_DESC": {
			"string": "来自辛空间工程公司的一套基本扩展模块，可小幅增加货舱空间。免责声明：使用未经许可的设备可能会使您的船只保修失效。",
			"version_hash": 576496090
		},
		"SYSTEM_CARGO_MOD_2K_SPECS": {
			"string": "载货量：2000 kg/矿物（总计12000 kg）\n兼容性：分离式和动态式\n质量：1,620kg\n制造商：辛空间工程",
			"version_hash": 3992873750
		},
		"SYSTEM_CARGO_MOD_4K": {
			"string": "E-Prime货仓扩容套件",
			"version_hash": 3295735106
		},
		"SYSTEM_CARGO_MOD_4K_DESC": {
			"string": "一份来自本地船厂的订单，旨在扩展您飞船的成品矿物货舱。安装服务附带退款保证、特别保修附加条款以及全面的结构完整性审查，让您安心无忧。祝您飞行安全！",
			"version_hash": 323616069
		},
		"SYSTEM_CARGO_MOD_4K_SPECS": {
			"string": "载货量：4000 kg/矿物（总计24000 kg）\n兼容性：分离式和动态式\n质量：3340 kg\n制造商：土卫二公司",
			"version_hash": 3179442623
		},
		"SYSTEM_CARGO_MOD_6K": {
			"string": "康列多“货运就绪”料斗",
			"version_hash": 1561821356
		},
		"SYSTEM_CARGO_MOD_6K_DESC": {
			"string": "一套采用专利Never-Void技术的船体嵌入式矿物容器，确保所有可用空间得到最大程度的利用。附带保修附录。该产品经过真实矿工在真实空间环境中的真实工作测试！ \n\n通知：安装日期晚于2237年的船舶，将无法就涉及康列多“货运就绪”料斗的操作/维护/安装/拆除/使用，或与之进行视觉/听觉/味觉/嗅觉/身体/心理接触而申请工伤赔偿。在从事涉及康列多“货运就绪”料斗的工作之前，请确保您和同事熟悉正确的操作程序。",
			"version_hash": 4226783348
		},
		"SYSTEM_CARGO_MOD_6K_SPECS": {
			"string": "载货量：6000 kg/矿物（总计36000 kg）\n兼容性：分离式和动态式\n质量：5560 kg\n制造商：康列多RVM",
			"version_hash": 1729976643
		},
		"SYSTEM_CARGO_MOD_BOTH_MANUAL": {
			"string": "需要MPU才能正常使用。\n被动增加舰载成品矿物容量。",
			"version_hash": 3337760521
		},
		"SYSTEM_CARGO_MOD_BOLTS": {
			"string": "货仓锁定螺栓套组",
			"version_hash": 227329904
		},
		"SYSTEM_CARGO_MOD_BOLTS_DESC": {
			"string": "适用于可变几何货舱船舶的一套标准锁定螺栓，用于固定在适当的固定点上。",
			"version_hash": 2550121865
		},
		"SYSTEM_CARGO_MOD_BOLTS_SPECS": {
			"string": "转换模式：动态式至分离式 \n转换比例：1:1（无缩减） \n质量缩减：2,650千克",
			"version_hash": 2493003163
		},
		"SYSTEM_CARGO_MOD_BOLTS_MANUAL": {
			"string": "将矿物存储转换为分离模式\n将总储存容量平均分成六份\n无需电力或反应堆热量",
			"version_hash": 4000447061
		},
		"SYSTEM_CARGO_MOD_AMORPH4": {
			"string": "康列多“无定型IV”",
			"version_hash": 3774452211
		},
		"SYSTEM_CARGO_MOD_AMORPH4_DESC": {
			"string": "尽管科松-217“弯曲器”的实验性变形货仓收效甚微，但康列多RVM仍然对这个概念情有独钟。在各造船厂达成试行协议后，尽管经历了多次失败，并多次错过最后期限，“无定型”IV货舱转换套件最终还是进入了市场。 \n\n其模块化部件可适配目前市场上所有船舶系统，并采用与其原始船舶相同的基本原理。",
			"version_hash": 579976662
		},
		"SYSTEM_CARGO_MOD_AMORPH4_SPECS": {
			"string": "转换模式：分离式至动态式\n转换比例：2:1（缩减50%）\n质量：1500千克\n机构质量：每吨处理空间损失增重20千克\n制造商：康列多RVM",
			"version_hash": 157192314
		},
		"SYSTEM_CARGO_MOD_AMORPH5": {
			"string": "THI MD-5货舱套件",
			"version_hash": 1415921821
		},
		"SYSTEM_CARGO_MOD_AMORPH5_DESC": {
			"string": "泰坦重工的MD-5货舱套件因其可折叠式内部空间而在造船厂工程师中广为人知。在吸取以往实施经验的基础上，该套件的硬件在货舱中占用的空间大大减少，但其紧凑的线性执行器和精密装配却带来了高昂的前期成本。",
			"version_hash": 113879615
		},
		"SYSTEM_CARGO_MOD_AMORPH5_SPECS": {
			"string": "转换模式：分离式至动态式\n转换比例：3:2（缩减33%）\n质量：2,500千克\n机构质量：每吨已处理矿物储存空间损失对应75千克\n制造商：泰坦重工",
			"version_hash": 3672340114
		},
		"SYSTEM_CARGO_MOD_AMORPH6": {
			"string": "NDSBH",
			"version_hash": 229190420
		},
		"SYSTEM_CARGO_MOD_AMORPH6_DESC": {
			"string": "中村动力的“软体货舱系统”是用于分隔货舱的终极动态转换套件，它摒弃了默认的固定隔板，转而采用了一种简单而有效的移动式隔板系统，该系统可根据船舶的规格进行定制。当隔板移动时，压缩空气会形成无摩擦的缓冲垫，而控制计算机则通过直接连接至货舱的处理单元和微震成像系统，来管理和预测未来的几何形状变化。",
			"version_hash": 867446996
		},
		"SYSTEM_CARGO_MOD_AMORPH6_SPECS": {
			"string": "转换模式：分离式至动态式\n转换比率：6:5（减少17%）\n质量：3,750千克\n机构质量：每吨已处理矿物储存空间损失对应165千克\n制造商：中村动力",
			"version_hash": 2625558195
		},
		"SYSTEM_CARGO_MOD_AMORPH_MANUAL": {
			"string": "需要MPU才能正常使用。\n将货舱储存容量转换为动态模式。\n根据转换比率增加或减少总储存容量。百分比已在规格中说明。\n不需要功率或反应堆热量。",
			"version_hash": 1241524766
		},
		"HUD_HOLD_CAP": {
			"string": "总容纳量",
			"version_hash": 2058380254
