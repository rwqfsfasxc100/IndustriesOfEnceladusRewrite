		"SYSTEM_HULLVAT_AMMO_1": {
			"string": "MPI Mounted Ammunition Canister",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_1_DESC": {
			"string": "Легкий магазин, що традиційно використовується для забезпечення додаткового місця під боєприпаси на суднах Вілсі за рахунок використання менш вживаних коридорів. Незважаючи на встановлення як вторинної системи, він все одно змушений використовувати люк подачі боєприпасів для доставки їх до вузлів кріплення, що обмежує швидкість подачі до швидкості поточного встановленого магазину. Перекриття вентиляційних отворів різними механізмами, що використовуються для подачі, викликає незначну \"духоту\", про яку повідомляють екіпажі; перебування на суднах з таким обладнанням може стати некомфортним після тривалого часу.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_1_SPECS": {
			"string": "Місткість боєприпасів: 6,000 кг \nЗменшення місткості компонентів дронів: 25% \nСуха маса: 3,000 кг \nВиробник: Mineral Processing Inc.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_MANUAL": {
			"string": "Додаткові боєприпаси для мас-драйверів. Сумісний з мас-драйверами та рейлганами. \nШвидкість подачі боєприпасів залежить від встановленого магазину. \nБоєприпаси продаються окремо на початку занурення. \nДисплеї сенсорів HUD можуть відображати нові значення коректно або ні.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_2": {
			"string": "ND Hollowed Hull Ammunition Magazine",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_2_DESC": {
			"string": "Спочатку заснований на механізмах контрабанди, що використовувалися під час конфліктів, ND HHAM (часто прозваний інсайдерами індустрії \"Ham\" — \"Шинка\") використовує вільний простір у корпусі корабля разом з великою частиною простору картриджа нанодронів, щоб вмістити колосальні 15 тонн додаткових боєприпасів для мас-драйвера. Хоча зазвичай він зарезервований для фахівців з ліцензією Вілсі, \"Шинка\" потрапила на цивільний ринок завдяки нещодавньому послабленню вимог до ліцензування, дозволяючи тим, у кого \"сверблять пальці\", займатися видобутком без зайвих проблем і не викликаючи при цьому синдром Кесслера.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_2_SPECS": {
			"string": "Місткість боєприпасів: 15,000 кг \nЗменшення місткості компонентів дронів: 50% \nСуха маса: 10,000 кг \nВиробник: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1": {
			"string": "Antonoff Ammunition Expansion Kit",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1_DESC": {
			"string": "Цей набір використовує простір для переробленого вантажу для зберігання додаткових снарядів на базі поточних встановлених комплектів. Відповідно до поточних законів Енцелада про маркування обладнання, відсотки зменшення будуть однаковими для всіх суден, що призводить до потенційної втрати простору на багатьох з них. Однак це піде на користь суднам з меншими внутрішніми трюмами або більшою місткістю магазинів, які отримають менші втрати або більші вигоди від цих законів.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1_SPECS": {
			"string": "Модифікатор місткості боєприпасів: +33% \nМісткість боєприпасів: 1,000 кг \nЗменшення трюму перероблених мінералів: 10% \nСуха маса: 9,000 кг \nВиробник: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2": {
			"string": "Antonoff 2x Ammunition Expansion Kit",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2_DESC": {
			"string": "Подвійне з'єднання AEK від Conlindo, що забезпечує подвійну потенційну місткість і подвійні обмеження. Через технічні обмеження довелося додати деяку додаткову масу, щоб дозволити двом механізмам працювати одночасно.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2_SPECS": {
			"string": "Модифікатор місткості боєприпасів: +67% \nМісткість боєприпасів: 2,000 кг \nЗменшення трюму перероблених мінералів: 20% \nСуха маса: 20,000 кг \nВиробник: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3": {
			"string": "Obonto Projectile Extendo+",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3_DESC": {
			"string": "Використовує інший підхід порівняно з ранніми технологіями розширення магазину, обираючи натомість пожертвувати частиною бака робочої маси. Через суперечливі закони Енцелада він дотримується універсального підходу до відсотка зменшення бака, але завжди гарантує, що 10 тонн робочої маси залишаться доступними, навіть якщо для цього доведеться зберігати робочу масу в тому ж контейнері, що й боєприпаси.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3_SPECS": {
			"string": "Модифікатор місткості боєприпасів: +100% \nМісткість боєприпасів: 1,000 кг \nЗменшення бака робочої маси: 33% \nСуха маса: 35,000 кг \nВиробник: Obonto Microengineering",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_1": {
			"string": "Runasimi Drone Component Vat",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_1_DESC": {
			"string": "Як і велика кількість комерційних продуктів Runasimi, DCV орієнтований на забезпечення невеликого приросту доступних компонентів нанодронів. Спочатку розроблений як резервний відсік, доступний лише під час надзвичайних ситуацій, у пізніших моделях було відкрито доступ до його вмісту під час штатного польоту.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_1_SPECS": {
			"string": "Місткість компонентів дронів: 6,000 кг \nЗменшення магазину боєприпасів: 25% \nСуха маса: 4,500 кг \nВиробник: Runasimi",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_MANUAL": {
			"string": "Додаткові деталі дронів для установок збірки нанодронів. Сумісний з усіма пусковими установками дронів. \nШвидкість подачі деталей дронів залежить від встановленого магазину. \nДеталі продаються окремо на початку занурення. \nДисплеї сенсорів HUD можуть відображати нові значення коректно або ні.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_2": {
			"string": "Runasimi Hull-Fitted Nanodrone Locker",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_2_DESC": {
			"string": "Базуючись на успіху DCV, у виробництво було запущено більший блок, щоб дозволити користувачам, які активно використовують нанодрони, ефективно задіяти часто невикористовуваний простір магазину мас-драйвера для розміщення значної кількості нанодронів. Відсутність будь-яких спеціалізованих блоків безпеки дозволила досягти кращого співвідношення простору \"деталі/магазин\", ніж у попередніх конструкціях.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_2_SPECS": {
			"string": "Місткість компонентів дронів: 15,000 кг \nЗменшення магазину боєприпасів: 50% \nСуха маса: 12,000 кг \nВиробник: Runasimi",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1": {
			"string": "Antonoff Nano Storage Expansion",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1_DESC": {
			"string": "Заснована на конструкції, подібній до лінійки комплектів розширення боєприпасів, ця модифікація замінює частину трюму для мінералів, дозволяючи зберігати більше компонентів нанодронів усередині судна. Зауважте, що до цих комплектів застосовуються ті ж закони, і межі коригування сховища є фіксованими, незалежно від судна.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1_SPECS": {
			"string": "Модифікатор місткості компонентів дронів: +33% \nМісткість компонентів дронів: 1,000 кг \nЗменшення трюму перероблених мінералів: 10% \nСуха маса: 10,500 кг \nВиробник: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2": {
			"string": "Antonoff Dual Nano Storage Expansion",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2_DESC": {
			"string": "Подібно до конструкторського рішення для наборів боєприпасів, Antonoff забезпечив подвійну комплектацію для своїх наборів NSE. Подібні обмеження застосовуються і тут.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2_SPECS": {
			"string": "Модифікатор місткості компонентів дронів: +67% \nМісткість компонентів дронів: 2,000 кг \nЗменшення трюму перероблених мінералів: 20% \nСуха маса: 25,000 кг \nВиробник: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3": {
			"string": "Obonto Liquid Nanobot Hold",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3_DESC": {
			"string": "Варіація сховища нанодронів на базі Obonto Projectile Extendo+, цей набір замінює значну частину бака робочої маси для зберігання додаткових компонентів нанодронів. Цей варіант навдивовижу популярний серед будівельних екіпажів, попри зменшення запасу палива, ймовірно, через нещодавнє послаблення правил щодо використання буксирувальних і вантажних дронів під час будівництва кілець.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3_SPECS": {
			"string": "Модифікатор місткості компонентів дронів: +100% \nМісткість компонентів дронів: 1,000 кг \nЗменшення бака робочої маси: 33% \nСуха маса: 40,000 кг \nВиробник: Obonto Microengineering",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_1": {
			"string": "Propellant Can Mk. I",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_1_DESC": {
			"string": "Створені на базі досліджень Conlindo у сфері динамічних розширювачів паливних баків, ці менші набори розширення призначені для екіпажів, що займаються дослідженнями, пошуково-рятувальними роботами або будівництвом, завдяки великій кількості простору, що залишається вільним через невикористання сховища перероблених матеріалів, і здатні перепрофілювати частину цього простору для робочої маси.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_1_SPECS": {
			"string": "Місткість робочої маси: 10,000 кг \nЗменшення трюму перероблених мінералів: 10% \nСуха маса: 1,500 кг \nВиробник: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_MANUAL": {
			"string": "Додаткова робоча маса для маневрових двигунів або основного двигуна. \nРобоча маса продається окремо на початку занурення. \nДисплеї сенсорів HUD можуть відображати нові значення коректно або ні.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_2": {
			"string": "Propellant Can Mk. II",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_2_DESC": {
			"string": "Сучасне вдосконалення порівняно з Mk. I, цей блок використовує більш ефективні методи зберігання, щоб займати менше місця на кілограм, ніж його попередник. Цей набір все ще може бути не найефективнішим для деяких екіпажів, оскільки значно важча рама відлякує деяких капітанів, незважаючи на його переваги.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_2_SPECS": {
			"string": "Місткість робочої маси: 25,000 кг \nЗменшення трюму перероблених мінералів: 22.5% \nСуха маса: 7,000 кг \nВиробник: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1": {
			"string": "Reaction Mass Tank Expander",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1_DESC": {
			"string": "Орієнтуючись на стабільні міжпланетні подорожі, Conlindo розробила це обладнання для заміни частини магазину мас-драйвера та сховищ компонентів нанодронів, які залишаються невикористаними під час подорожей на такі дистанції, щоб вмістити більше робочої маси на кораблі. Попри те, що стандартні міжпланетні баки є законодавчо встановленим мінімумом, додаткова надлишковість дозволяє пілотам виконувати додаткові маневри, не ризикуючи спорожнити бак і дрейфувати решту шляху.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1_SPECS": {
