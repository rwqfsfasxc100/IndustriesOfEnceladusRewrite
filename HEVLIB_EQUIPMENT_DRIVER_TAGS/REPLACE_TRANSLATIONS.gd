		},
		"SYSTEM_THRUSTER_PIN150": {
			"string": "RMS Pin-C50推进器",
			"version_hash": 503674612
		},
		"SYSTEM_THRUSTER_PIN150_DESC": {
			"string": "拉萨玛玛材料解决方案的Pin-C50是一种独特的固态推进器，它利用脉冲感应技术对氢等离子体进行加速和矢量控制，无需任何机械组件，从而极大地减少了传统推进器常见的因机械磨损或故障引发的问题。然而，在加速过程中，它们确实会承受额外的应力，并且在比传统推进器低得多的加速度下就会失效。 \n\n尽管该系统极其耐用，但安装沉重的等离子体导管和配套电力基础设施，以及将推进器直接嵌入飞船船体，都需要专业人员协助，而这带来的成本可能难以负担。",
			"version_hash": 1271884051
		},
		"SYSTEM_THRUSTER_PIN150_SPECS": {
			"string": "推力：150 kN\n排气速度：90 km/s\n推进剂消耗量：1.6 kg/s\n电力消耗：90 MW\n运行模式：虚拟可变推力\n矢量推力角度：36 deg\n推进剂：氢等离子体\n质量：185千克（每台推进器）\n制造商：拉萨玛玛材料解决方案",
			"version_hash": 913236076
		},
		"SYSTEM_THRUSTER_BLAST": {
			"string": "ERS-BlasTR 7200推进器",
			"version_hash": 657341998
		},
		"SYSTEM_THRUSTER_BLAST_DESC": {
			"string": "电子驾驶系统的BlasTR完全颠覆了其前作NAGHET的设计，它采用螺旋磁等离子体动力加速器，以同样不可思议的排气速度实现了惊人的推力。该产品主要面向竞速飞船市场，同时也吸引了重型舰船运营商的关注，这些船只长期以来对高推力的需求一直依赖于推进剂经济性较差的推进器。",
			"version_hash": 1965070975
		},
		"SYSTEM_THRUSTER_BLAST_SPECS": {
			"string": "推力：450 kN\n排气速度：22 km/s\n推进剂消耗量：20.5 kg/s \n电力消耗：72 MW\n热量消耗：5.0 GW\n运行模式：可变推力\n推进剂：氧氢等离子体\n质量：145 kg（每个推进器）\n制造商：电子驾驶系统",
			"version_hash": 187101429
		},
		"SYSTEM_THRUSTER_PNTRM": {
			"string": "ND-PNTRm推进器",
			"version_hash": 1339790742
		},
		"SYSTEM_THRUSTER_PNTRM_DESC": {
			"string": "PNTR的显著成功向中村动力公司表明，古老的精密万向节支架问题可以通过固态推力矢量技术完全规避，该公司迅速着手将该系统有效缩小规模，以用作RCS推进器。 \n\n尽管作为纯核热火箭的排气速度较差，但微型脉冲核热火箭凭借当今市场上最大的有效推力矢量范围弥补了这一不足。其低运营成本和快速预热使其成为RCS推进器布局受限的重型船只的理想选择。",
			"version_hash": 3905767052
		},
		"SYSTEM_THRUSTER_PNTRM_SPECS": {
			"string": "推力：450 kN \n排气速度：5 km/s \n推进剂消耗量：90.0 kg/s\n电力消耗：40 MW\n热量消耗：1.8 GW\n操作模式：脉冲推力\n矢量推力角度：60度\n推进剂：氧氢等离子体\n质量：25公斤（每个推进器）\n制造商：中村动力",
			"version_hash": 1889676704
		},
		"SYSTEM_SALVAGE_ARM_HEAVY": {
			"string": "俄原-安东诺夫ORD",
			"version_hash": 3844473405
		},
		"SYSTEM_SALVAGE_ARM_HEAVY_DESC": {
			"string": "在合作开发KTA24的过程中，俄原-安东诺夫公司迅速发现了三曲枝图-阿姆斯特朗AR-1500的缺陷。这款设备操作缓慢且精密，但作为矿石回收工具使用时，其精密的伺服系统和精心设计的对接适配器很快就会磨损。ORD正是他们针对这些缺陷所推出的解决方案。 \n\n尽管其笨重的支撑结构使其格外沉重且耗能，但耐磨的电机和轴承让它成为了同类产品中可行且耐用的替代品。",
			"version_hash": 2319603105
		},
		"SYSTEM_SALVAGE_ARM_HEAVY_SPECS": {
			"string": "出力：3200 kN \n臂程：40 m\n功耗（峰值）：220 MW\n安装位置：仅限高强度挂载点\n质量：14000 kg\n制造商：俄原-安东诺夫",
			"version_hash": 890191113
		},
		"SYSTEM_SALVAGE_ARM_LIGHT": {
			"string": "鲁纳斯米KRB-500",
			"version_hash": 3632982126
		},
		"SYSTEM_SALVAGE_ARM_LIGHT_DESC": {
			"string": "鲁纳斯米KRB-500样品操作臂最初是为资金较少的研究机构的船只开发的，但最近在采矿业找到了新的细分市场，成为纳米无人机系统的便捷替代品。 \n\n该机械手的执行器采用带制动盘的液力耦合器来模拟步进电机或伺服电机的精度，这是一种新颖的实现方式，可最大限度地降低维护费用和整体质量。此外，其抓爪可磁化，用于夹持小型铁磁性物体，如无人机外壳，但其夹持力可能不足以应对较大的船只。 \n\n注：分析和实验套餐需单独购买。",
			"version_hash": 3810894454
		},
		"SYSTEM_SALVAGE_ARM_LIGHT_SPECS": {
			"string": "出力：500 kN \n臂程：35 m\n功耗（峰值）：60 MW \n质量：2050 kg\n制造商：鲁纳斯米公司",
			"version_hash": 431506001
		},
		"SYSTEM_SALVAGE_ARM_LONG": {
			"string": "TR-60延长型机械臂",
			"version_hash": 3370268219
		},
		"SYSTEM_SALVAGE_ARM_LONG_DESC": {
			"string": "三曲枝图-阿姆斯特朗面向采集作业的机械臂。其智能化的结构设计与巧妙的机械构造使得相对轻巧灵便的机体能够输出高扭矩，但使用复杂的专有部件导致维护周期频繁且昂贵。",
			"version_hash": 2981052471
		},
		"SYSTEM_SALVAGE_ARM_LONG_SPECS": {
			"string": "出力：700 kN\n臂程：60 m\n功耗（峰值）：170 MW\n质量：7750 kg\n制造商：三曲枝图-阿姆斯特朗",
			"version_hash": 705504333
		},
		"SYSTEM_MAIN_ENGINE_NANI": {
			"string": "SSE NANI火炬兼容型",
			"version_hash": 102908080
		},
		"SYSTEM_MAIN_ENGINE_NANI_DESC": {
			"string": "这个滑稽得不切实际，且完全令人厌恶的主火炬，是无数个把酒言欢、苦思人生意义的夜晚的终极逻辑产物。在断定人生毫无意义后，辛空间工程公司的团队集思广益，搞出了这么个玩意儿。 \n\n免责声明：Omaewamou-Shindeiru认为这非常有趣，并完全赞同将NANI用作推进解决方案。可能会使船舶保修失效。在某些船舶上将其用作主火炬可能会损坏您的反应堆。祝您使用愉快！",
			"version_hash": 29273335
		},
		"SYSTEM_MAIN_ENGINE_NANI_SPECS": {
			"string": "推力：3,450 kN\n排气速度：132 km/s \n推进剂消耗量：0.5 kg/s \n电力消耗：200 MW\n热量消耗：2 GW\n推进剂：超临界液态铀盐\n燃烧时间：1分钟（预估）\n质量：10000 kg\n制造商：辛空间工程 / Omaewamou-Shindeiru",
			"version_hash": 846653473
		},
		"SYSTEM_MAIN_ENGINE_GEMINI": {
			"string": "MA-NTR600-II双引擎",
			"version_hash": 2716215589
		},
		"SYSTEM_MAIN_ENGINE_GEMINI_DESC": {
			"string": "NTR600-II，亦称“双子座”，是一款采用双喷口布局的磁等离子体动力推进器，兼具可观的推力、卓越的效率与极高的可靠性。其双喷口设计结合基础推力矢量控制系统，赋予了推进器额外的矢量调节能力，进一步提升了整体运行效率。\n\n免责声明：光田-星际客车提醒用户，该MPD运行所需的巨大功率会对反应堆造成沉重负荷，可能导致设备在远高于其他民用级推进器的温度下发生故障。此单元的维护仅可由光田-星际客车工程师或持证分包商执行。外太阳系目前尚无可用的保险计划。",
			"version_hash": 4245011721
		},
		"SYSTEM_MAIN_ENGINE_GEMINI_SPECS": {
			"string": "推力：1,200 kN \n排气速度：28 km/s \n推进剂消耗量：52 kg/s\n电力消耗：250 MW\n热量消耗：16.8 GW\n矢量推力角度：60 deg\n矢量推力速度：20 deg/s\n运行模式：可变推力\n推进剂：氢等离子体\n质量：4350 kg\n制造商：光田-星际客车",
			"version_hash": 359774482
		},
		"SYSTEM_MAIN_ENGINE_SOYUZ": {
			"string": "RA-TNTRL-R44四联引擎",
			"version_hash": 3205954369
		},
		"SYSTEM_MAIN_ENGINE_SOYUZ_DESC": {
			"string": "这种“火炬”装置的存在绝非无稽之谈。俄原-安东诺夫公司曾试图推出自家的多喷口推进组件，以与其他同类产品竞争，但研发进展缓慢，到了 22 世纪末，尽管尝试了多种原型设计，却始终未能拿出切实可行的方案。\n\n关于其发明过程的传闻众说纷纭，但普遍流传的一种说法是：该项目的主设计师在梦中见到了苏联传奇火箭工程师瓦连京·格鲁什科的幽灵。格鲁什科只说了一个词——“联盟”——便飘然离去，留下了一台 K44 RCS 推进器在设计师脚边。\n\n这类组合式推进装置的生产一直延续至今，这也是K44推进器如今依然存量巨大的原因之一。",
			"version_hash": 2622262715
		},
		"SYSTEM_MAIN_ENGINE_SOYUZ_SPECS": {
			"string": "推力：1600 kN \n排气速度：15 km/s\n推进剂消耗量：106.4 kg/s\n电力消耗：60 MW\n热量消耗：12.0 GW\n操作模式：脉冲推力\n推进剂：氧氢等离子体\n质量：650 kg\n制造商：俄原-安东诺夫",
			"version_hash": 1658291400
		},
		"SYSTEM_MAIN_ENGINE_THUNDER": {
			"string": "RA-K69V四联引擎",
			"version_hash": 3527062166
		},
		"SYSTEM_MAIN_ENGINE_THUNDER_DESC": {
			"string": "这款火炬是一款定制设计的设备，它采用了R44的框架，并用K69V推进器取代了其发动机，还配备了该系列在赛道赛车手间非常出名的万向支架。安装时可选配完全合法的“雷暴船级”应答器改装。如有特殊要求，还可提供个人抓钩。",
			"version_hash": 2146529517
		},
		"SYSTEM_MAIN_ENGINE_THUNDER_SPECS": {
			"string": "推力：1600 kN\n排气速度：12 km/s\n推进剂消耗量：133.2 kg/s\n电力消耗：100 MW\n热量消耗：14.4 GW\n矢量推力角度：25 deg\n矢量转向速度：360 deg/s\n运行模式：矢量脉冲推力\n推进剂：氧氢等离子体\n质量：950 kg\n制造商：定制/俄原-安东诺夫",
			"version_hash": 2233516597
		},
		"SYSTEM_MAIN_ENGINE_PIN1200": {
			"string": "RMS Pin-M200引擎",
			"version_hash": 1077983648
		},
		"SYSTEM_MAIN_ENGINE_PIN1200_DESC": {
			"string": "拉萨玛玛材料解决方案的Pin-M200采用了与其Pin-C50系列固态RCS推进器相同的脉冲感应技术，但规模更大。尽管这种技术放大导致推进器结构相对脆弱，但其可靠性指标仍处于同类竞争产品的正常范围内。\n\n放大后的技术产生了巨大的热功率，要求反应堆直接输出超过60GW的功率以维持额定燃烧。鉴于这一功率需求甚至超过了竞速级反应堆的水平，设计团队决定配备一台微型聚变反应堆作为动力源。与同类聚变火炬不同，该反应堆仅用于提供热能，而非产生推力的必要组件。受限于聚变燃料的储量，其燃烧时间约为一个半小时。",
			"version_hash": 2466078966
		},
		"SYSTEM_MAIN_ENGINE_PIN1200_SPECS": {
			"string": "推力：1,200 kN\n排气速度：105 km/s\n推进剂消耗量：11.4千克/秒\n电力消耗：550 MW\n矢量推力角度：40 deg\n运行模式：矢量可变推力\n推进剂：氢等离子体/铀盐\n燃烧时间：90 分钟（预计）\n质量：550 MW\n制造商：拉萨玛玛材料解决方案",
			"version_hash": 1830654905
		},
		"SYSTEM_MAIN_ENGINE_CRACK": {
			"string": "NDDFD引擎",
			"version_hash": 4036807547
		},
		"SYSTEM_MAIN_ENGINE_CRACK_DESC": {
			"string": "中村动力的定向聚变爆轰引擎是市面上现存最强大——也是最早问世——的聚变推进方案之一。该引擎曾因2214年一则现已臭名昭著的广告而广为人知，该则广告使用了Vengaboys乐队的歌曲《Boom, Boom, Boom, Boom》作为背景音乐。NDDFD的工作原理是利用强力电磁铁，将内部充有加压氘氚气体的预热铁磁性外壳瞬间压碎，引发聚变爆轰，随后将产生的爆轰产物定向喷射出其笼状喷嘴组件。\n\n与其竞争对手不同，NDDFD需要大量且持续的电力供应来维持推进，此外，它的燃料颗粒体积相对较大且需要专门的进料装置，这极大地限制了其在小型飞船上的燃料装载量。",
			"version_hash": 1795382237
		},
		"SYSTEM_MAIN_ENGINE_CRACK_SPECS": {
			"string": "推力：1800 kN \n排气速度：1850 km/s\n推进剂消耗：1 kg/s \n电力消耗：445 MW\n操作模式：脉冲推力\n推进剂：氢等离子体\n聚变燃料：氘-氚\n燃烧时间：30 分钟（预计）\n质量：4650 kg\n制造商：中村动力",
			"version_hash": 919709828
		},
		"SYSTEM_MAIN_ENGINE_ZURBIN": {
			"string": "ND ZURBIN引擎",
			"version_hash": 3993811975
		},
		"SYSTEM_MAIN_ENGINE_ZURBIN_DESC": {
			"string": "Zurbin引擎是月读级护卫舰的高性能主引擎。尽管该级护卫舰早已退出现役，不再参与战斗任务，这些引擎至今仍在使用。中村动力曾致力于将报废护卫舰上的引擎重新利用，安装在他们的噬菌体级自主空间站上。",
			"version_hash": 601565468
		},
		"SYSTEM_MAIN_ENGINE_ZURBIN_SPECS": {
			"string": "推力：6900 kN \n排气速度：66 km/s\n推进剂消耗量：104.5 kg/s\n电力消耗：50 MW\n运行模式：可变推力\n推进剂：氧氢等离子体\n质量：10000 kg\n制造商：中村动力",
			"version_hash": 1441569589
		},
		"SYSTEM_MAIN_ENGINE_PMS": {
			"string": "ND PMS引擎",
			"version_hash": 3240131645
		},
		"SYSTEM_MAIN_ENGINE_PMS_DESC": {
			"string": "PMS是NTTR推进器的早期前身。作为中村动力首款大型NTR型推进器，其推进剂经济性极差，推力对纯NTR而言也低于标准，但其可靠性仍然令人称道。PMS能够在远超市场上任何其他推进器的应力下运行，并且以其功率而言极为坚固，即便在其他推力器难以应付的极端恶劣环境下，它依然能保持稳定运行。",
			"version_hash": 2154944331
		},
		"SYSTEM_MAIN_ENGINE_PMS_SPECS": {
			"string": "推力：3000 kN\n排气速度：3 km/s \n推进剂消耗量：1000 kg/s\n电力消耗：20兆瓦\n热量消耗：4.5 GW\n运行模式：可变推力\n推进剂：氧氢等离子体\n质量：250 kg\n制造商：中村动力",
			"version_hash": 2901639713
		},
		"IOER_TRANSIT_TIP_1": {
			"string": "预处理器单元在矿块进入矿物处理单元之前，从矿块中抽出水分，以缩短处理矿块所需的时间。",
			"version_hash": 1298930922
		},
		"IOER_TRANSIT_TIP_2": {
			"string": "拥有矿物效率加成的预处理器能增加你从矿块中提取的金属量。",
			"version_hash": 2657296036
		},
		"IOER_TRANSIT_TIP_3": {
			"string": "想在其他飞船上使用Cothon-217的可变成品矿物储存吗？那就使用像NDSBH这样的货舱转换套件吧。",
			"version_hash": 697902233
		},
		"IOER_TRANSIT_TIP_4": {
			"string": "需要额外的加工矿石存储空间吗？安装一个货舱扩展模块或一个货舱辅助存储模块。",
			"version_hash": 1984517216
		},
		"IOER_TRANSIT_TIP_5": {
			"string": "居住舱套件可以提高船只的乘员容量，但需注意新环境可能导致的士气变化。",
			"version_hash": 2261321500
		},
		"IOE_TUNE_PARAMETER_PREPROC_MELT_POWER_DRAW": {
			"string": "（每矿块的）水回收功耗",
			"version_hash": 1562137441
		},
		"IOE_TUNE_PREPROC_RECLAIM": {
			"string": "解冻速度",
			"version_hash": 3472595481
		},
		"IOE_TUNE_PREPROC_RECLAIM_DESC": {
			"string": "提升预处理装置的解冻速率将加速融化流程的进行，同时导致能耗上升。这种较高的处理效率可能引发回收系统过饱和，从而减少回收水的水量；此外，由于切割控制系统为保障矿物产出，不得不降低对矿石加工方式的精确控制，更快的速率也会提高矿块的水分含量下限。\n\n相反，降低处理速度则有助于提升整体加工性能，因为这为回收装置和切割控制系统提供了更多回旋余地。",
			"version_hash": 1166901174
		},
		"IOE_TUNE_PARAMETER_PREPROC_MELT_REMASS_EFFICIENCY": {
			"string": "冰反作用质量提取效率",
			"version_hash": 3782386725
		},
		"IOE_TUNE_PARAMETER_PREPROC_CHUNK_WATER_MASS_CEILING": {
			"string": "矿块最小含水量",
			"version_hash": 840275576
		},
		"IOE_TUNE_FAB_SPEED": {
			"string": "制造打印速度",
			"version_hash": 4127227909
		},
		"IOE_TUNE_FAB_SPEED_DESC": {
			"string": "调整制造单元将成品矿物转化为消耗品的速率。生产线内部的低效现象会随生产速率的提高而成比例放大，速度提升会相应增加生产过程中的电力和材料消耗。",
			"version_hash": 3230248524
		},
		"IOE_TUNE_PARAMETER_PRINT_POWER_DRAW": {
			"string": "打印功耗",
			"version_hash": 3168425227
		},
		"IOE_TUNE_PARAMETER_PRINT_MATERIAL_EFFICIENCY": {
			"string": "效率低下带来的额外材料成本",
			"version_hash": 2047110542
		},
		"SYSTEM_MWTIGHTBEAM": {
			"string": "RA DMW炮",
			"version_hash": 2618579005
		},
		"SYSTEM_MWTIGHTBEAM_DESC": {
			"string": "俄原-安东诺夫的定向微波炮利用长管状波导将微波聚焦成紧密的辐射束。其模块化和非专用组件价格低廉且易于维修，但高昂的安装成本和中等功率效率抵消了这些优势。",
			"version_hash": 2758148380
		},
		"SYSTEM_MWTIGHTBEAM_SPECS": {
			"string": "有效范围：800 m\n电力消耗：120 MW\n输出功率：90 MW\n波长：1 cm\n质量：400 kg\n制造商：俄原-安东诺夫",
			"version_hash": 298178068
		},
		"SYSTEM_MWTIGHTBEAM_PDT": {
			"string": "RADMW-8120",
			"version_hash": 3416819864
		},
		"SYSTEM_MWTIGHTBEAM_PDT_DESC": {
			"string": "这款俄原-安东诺夫联合生产的DMW加农炮被安装在中村动力的NDPT炮塔上。它具有与42xx系列点防御轨道炮塔相似的操控特性和可调节的配置参数，不过其万向节驱动器必须降速，以妥善管理该装置沉重的交流电缆。 \n\nDMW-CT能够自动锁定并跟踪目标，但与同类轨道炮不同，它无需人工指令即可开火。",
			"version_hash": 3292718291
		},
		"SYSTEM_MWTIGHTBEAM_PDT_SPECS": {
			"string": "有效范围：800 m\n火控AI：1级\n电力消耗：120 MW\n输出功率：90 MW\n波长：1 cm\n质量：3000 kg\n制造商：俄罗斯国家原子能",
			"version_hash": 3649933006
		},
