			"version_hash": 1532161049
		},
		"SYSTEM_HULLVAT_AMMO_1": {
			"string": "MPI组装式弹药罐",
			"version_hash": 3278770497
		},
		"SYSTEM_HULLVAT_AMMO_1_DESC": {
			"string": "一种轻型弹药储存，传统上用于为狼群舰艇提供额外的弹匣空间，利用船上较少使用的走廊。尽管被安装为辅助系统，它仍需利用弹药输送舱口将弹药运送到挂载点，导致送弹速度受限于当前安装的弹药库。由于各种用于给弹匣供弹的机制侵入了通风口，船员时常报告轻微的“闷热感”，长时间乘坐此类舰艇的人员可能会感到不适。",
			"version_hash": 179636556
		},
		"SYSTEM_HULLVAT_AMMO_1_SPECS": {
			"string": "弹药储量：6000 kg\n纳米无人机存储缩减：25%\n干重：3000 kg\n制造商：火星动力工业",
			"version_hash": 3108622655
		},
		"SYSTEM_HULLVAT_AMMO_MANUAL": {
			"string": "用于质量驱动器的额外弹药，兼容质量驱动器和轨道炮。\n弹药供应速率取决于已安装的弹药库。\n弹药在潜环开始时单独出售。\n任何消耗品缩减效果都不适用于存储的前三分之一。\nHUD传感器显示屏可能无法正确显示新的数值。\n由于严格的操作限制，Minding虚拟飞行服务可能无法兼容此设备，仅能提供与舰载储存标称数量相符的弹药。",
			"version_hash": 2099048926
		},
		"SYSTEM_HULLVAT_AMMO_2": {
			"string": "NDHHAM",
			"version_hash": 3267927637
		},
		"SYSTEM_HULLVAT_AMMO_2_DESC": {
			"string": "中村动力空心弹仓（业内人士常戏称为“火腿”）最初基于冲突期间使用的走私机制，利用船体内部多余空间以及大部分纳米无人机弹药舱空间，可额外装载多达15吨的质量加速器弹药。尽管该弹仓通常仅供狼群许可的专业人士使用，但由于最近对中小型船只集装箱限制的重新评估，“火腿”已进入民用市场。不过。对弹药供给系统的修改去除了所有减震设备，包括那些涉及质心位置维持的设备，导致许多船员在航行中感到不适。",
			"version_hash": 1007879920
		},
		"SYSTEM_HULLVAT_AMMO_2_SPECS": {
			"string": "弹药储量：15000 kg\n纳米无人机存储缩减：50%\n干重：10000千克\n制造商：中村动力",
			"version_hash": 424271257
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1": {
			"string": "安东诺夫弹药扩展套件",
			"version_hash": 4085650142
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1_DESC": {
			"string": "该套件利用已处理的存储空间，根据当前安装的套件来存储额外的弹药。由于土卫二现行设备标签法规，无论船只大小，成品矿物容量的减少百分比都是相同的，这可能导致许多船只的空间被浪费。然而，对于内部货舱较小或弹药库容量较大的船只而言，这将是有利的，因为它们能通过更小的损失获得更大的收益。",
			"version_hash": 2860227491
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1_SPECS": {
			"string": "弹药储量修改：+33%\n弹药储量：1000 kg\n成品矿物储量缩减：10%\n干重：9000 kg\n制造商：安东诺夫",
			"version_hash": 2756158797
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2": {
			"string": "安东诺夫2x弹药扩展套件",
			"version_hash": 1719166248
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2_DESC": {
			"string": "康列多AEK的双重耦合，提供了两倍的潜在容量，同时也承受了两倍的约束。由于技术限制，不得不增加一些额外质量，以便让两套机构能够同时运作。",
			"version_hash": 2771221711
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2_SPECS": {
			"string": "弹药储量修改：+67%\n弹药储量：2000 kg\n成品矿物储量缩减：20%\n干重：20000 kg\n制造商：安东诺夫",
			"version_hash": 753476287
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3": {
			"string": "友邦拓投射物扩展+",
			"version_hash": 3279727785
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3_DESC": {
			"string": "为了扩展质量加速器的弹药库，该技术采用了与以往不同的方法，选择牺牲一部分推进剂储箱。由于与土卫二法律存在冲突，该技术在储箱缩减比例上遵循“一刀切”原则，但始终确保至少有10吨推进剂可用，即使这意味着推进剂必须与弹药储存在同一个容器中。",
			"version_hash": 2006291509
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3_SPECS": {
			"string": "弹药储量修改：+100%\n弹药储量：1000 kg\n推进剂储箱缩减：33%\n干重：35000 kg\n制造商：友邦拓微工程",
			"version_hash": 913558175
		},
		"SYSTEM_HULLVAT_NANO_1": {
			"string": "鲁纳斯米无人机组件库",
			"version_hash": 192326595
		},
		"SYSTEM_HULLVAT_NANO_1_DESC": {
			"string": "与鲁纳斯米的众多商业产品一样，DCV的重点在于为现有的纳米无人机组件提供小幅提升。最初，它被设计为一个仅在紧急情况下可用的备用舱，后来经过第三方改装，它们可以连接到与船上无人机交付系统相连的料斗，从而将组件输送到装配厂。连接料斗时并不使用降噪技术。",
			"version_hash": 2972814653
		},
		"SYSTEM_HULLVAT_NANO_1_SPECS": {
			"string": "无人机部件储量：6000 kg \n弹药库缩减：25%  \n干重：4500 kg  \n制造商：鲁纳斯米公司",
			"version_hash": 3272993773
		},
		"SYSTEM_HULLVAT_NANO_MANUAL": {
			"string": "用于纳米无人机装配单元的额外无人机零件。兼容所有无人机发射器。\n无人机零件供应速率取决于已安装的储存。\n零件在潜水开始时单独出售。\n任何消耗品缩减效果都不适用于存储的前三分之一。\nHUD传感器显示屏可能无法正确显示新的数值。\n由于严格的操作限制，Minding虚拟飞行服务可能无法兼容此设备，仅能提供与舰载储存标称相符的无人机零件。",
			"version_hash": 1846628783
		},
		"SYSTEM_HULLVAT_NANO_2": {
			"string": "鲁纳斯米船体贴合式纳米无人机收纳箱",
			"version_hash": 2890336819
		},
		"SYSTEM_HULLVAT_NANO_2_DESC": {
			"string": "基于DCV的成功，一种更大的装置被投入生产，以使纳米无人机重度用户能够充分利用通常闲置的质量驱动器弹匣空间，从而装载相当大比例的纳米无人机。由于缺乏任何专用的安全装置，与之前的设计相比，其零件与弹匣空间的比例更大，然而，由于质量平衡器的构造效率低下，在机动过程中容易产生噪音。",
			"version_hash": 3524422214
		},
		"SYSTEM_HULLVAT_NANO_2_SPECS": {
			"string": "无人机部件储量：15000 kg\n弹药库缩减：50%\n干重：12000 kg\n制造商：鲁纳斯米公司",
			"version_hash": 1373418373
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1": {
			"string": "安东诺夫纳米存储扩展",
			"version_hash": 15150678
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1_DESC": {
			"string": "基于与弹药扩展改装套件系列相似的设计，此项改装会占用一部分矿物货舱空间，以便在舰船内储存更多的纳米无人机部件。请注意，这些套件适用相同的法规，且无论舰船型号如何，储存调整范围均固定为标签所标注的数值。",
			"version_hash": 2714536047
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1_SPECS": {
			"string": "无人机部件储量修改：+33%\n无人机部件储量：1000 kg\n成品矿物储量缩减：10%\n干重：10500 kg\n制造商：安东诺夫",
			"version_hash": 2336784630
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2": {
			"string": "安东诺夫双重纳米存储扩展",
			"version_hash": 424000540
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2_DESC": {
			"string": "与弹药套件的设计选择类似，安东诺夫为其NSE配件提供了双重套件配置。类似的限制条件仍然适用。",
			"version_hash": 4235882865
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2_SPECS": {
			"string": "无人机部件储量修改：+67%\n无人机部件储量：2000 kg\n成品矿物储量缩减：20%\n干重：25000 kg\n制造商：安东诺夫",
			"version_hash": 2510244896
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3": {
			"string": "友邦拓液态纳米机器人储存装置",
			"version_hash": 1179264534
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3_DESC": {
			"string": "友邦拓友邦拓投射物扩展+的纳米无人机存储变体，该套件取代了相当大一部分推进剂罐，以存储额外的纳米无人机组件。尽管这种变体对推进剂存储造成了影响，但在建筑工人中却出奇地受欢迎，可能是由于最近对在环内使用拖曳式纳米无人机载具的监管有所放松。",
			"version_hash": 3081086819
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3_SPECS": {
			"string": "无人机部件储量修改：+100%\n无人机部件储量：1000 kg\n推进剂储箱缩减：33%\n干重：40000 kg\n制造商：友邦拓微工程",
			"version_hash": 141875351
		},
		"SYSTEM_HULLVAT_PROP_1": {
			"string": "Mk. I推进剂储罐",
			"version_hash": 3501193927
		},
		"SYSTEM_HULLVAT_PROP_1_DESC": {
			"string": "这些较小的扩展套件基于康列多对动态推进剂储罐扩展器的研发，旨在供参与研究、搜救或施工的人员使用，因为未使用的成品矿物存储空间充足，并且能够将其中的一部分用于储存反作用工质。",
			"version_hash": 480660045
		},
		"SYSTEM_HULLVAT_PROP_1_SPECS": {
			"string": "推进剂储量：10000 kg\n成品矿物储量缩减：10%\n干重：1500 kg\n制造商：康列多RVM",
			"version_hash": 4086044900
		},
		"SYSTEM_HULLVAT_PROP_MANUAL": {
			"string": "用于推进器和涡轮机的额外反作用工质。\n反作用工质在潜环开始时单独出售 \n任何消耗品缩减效果都不适用于存储的前三分之一。\nHUD传感器显示屏可能无法正确显示新的数值。\n由于严格的操作限制，Minding虚拟飞行服务可能无法兼容此设备，仅提供与舰载储存标称相符的反作用工质量。",
			"version_hash": 4229656179
		},
		"SYSTEM_HULLVAT_PROP_2": {
			"string": "Mk. II推进剂储罐",
			"version_hash": 3870249968
		},
		"SYSTEM_HULLVAT_PROP_2_DESC": {
			"string": "作为Mk.I的现代化改进版，该装置采用了更高效的存储方法，使其每公斤所占空间比前代产品更小。然而，这套装备对某些船员来说可能仍非理想选择，因为其明显更重的框架让一些船长对其优势望而却步。",
			"version_hash": 2342587130
		},
		"SYSTEM_HULLVAT_PROP_2_SPECS": {
			"string": "推进剂储量：25000 kg\n成品矿物储量缩减：22.5%\n干重：7000 kg\n制造商：康列多RVM",
			"version_hash": 4228987441
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1": {
			"string": "反作用工质储罐扩展器",
			"version_hash": 2491541107
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1_DESC": {
			"string": "康列多专注于实现稳定的星际旅行，因此设计了这种设备，以替换质量驱动器弹匣和纳米无人机组件存储器中在如此远距离旅行中未使用的部分，从而在飞船中装入更多推进剂。尽管标准的星际间储罐在法律上已达到最低要求，但增加的冗余度允许飞行员进行额外机动，而不必冒险耗尽储罐并漂移完剩余航程。",
			"version_hash": 3807540147
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1_SPECS": {
			"string": "推进剂储量修改：+25% \n弹药库缩减：17% \n无人机部件储量缩减：17% \n干重：3000 kg\n制造商：康列多RVM",
			"version_hash": 2398896048
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_2": {
			"string": "2x反作用工质储罐扩展器",
			"version_hash": 284167773
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_2_DESC": {
			"string": "康列多专注于实现稳定的星际旅行，因此设计了这种设备，以替换质量驱动器弹匣和纳米无人机组件存储器中在如此远距离旅行中未使用的部分，从而在飞船中装入更多推进剂。尽管标准的星际间储罐在法律上已达到最低要求，但增加的冗余度允许飞行员进行额外机动，而不必冒险耗尽储罐并漂移完剩余航程。\n\n该设备的双重适配功能可为有需要的船只提供额外的推进剂存储空间。",
			"version_hash": 1897745097
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_2_SPECS": {
			"string": "推进剂储量修改：+50%\n弹药库缩减：25%\n无人机部件储量缩减：25%\n干重：8000 kg\n制造商：康列多RVM",
			"version_hash": 3256748785
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_3": {
			"string": "超级反作用工质储罐扩展器",
			"version_hash": 251378402
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_3_DESC": {
			"string": "康列多专注于实现稳定的星际旅行，因此设计了这种设备，以替换质量驱动器弹匣和纳米无人机组件存储器中在如此远距离旅行中未使用的部分，从而在飞船中装入更多推进剂。尽管标准的星际间储罐在法律上已达到最低要求，但增加的冗余度允许飞行员进行额外机动，而不必冒险耗尽储罐并漂移完剩余航程。\n\n该设备的三重适配功能为确实有此需求的船只提供了额外的推进剂存储空间。",
			"version_hash": 3734981527
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_3_SPECS": {
			"string": "推进剂储量修改：+75% \n弹药库缩减：38% \n无人机部件储量缩减：38% \n干重：15000 kg \n制造商：康列多RVM",
			"version_hash": 2866517550
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_1": {
			"string": "铁雄SCARLETTE输送驱动器",
			"version_hash": 3530444192
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_1_DESC": {
			"string": "SCARLETTE驱动器是一个旨在重塑向硬点输送消耗品的方式的模块。该设备最初用于军事领域，但在与中村动力的合同终止后，SCARLETTE被重新定位为工业级改装组件。尽管它主要应用于工业级质量加速器装置，但一些对质量加速器有极高需求的舰长，也能将该模块的效能发挥到极致。",
			"version_hash": 730057691
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_1_SPECS": {
			"string": "消耗品存储输送速度：+75%\n干重：3800 kg\n制造商：铁雄工程",
			"version_hash": 1444740798
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_MANUAL": {
			"string": "按比例提升适用消耗品存储的输送速度。\n与工业级设备配合使用效果最佳。",
			"version_hash": 2167944361
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_2": {
			"string": "铁雄RamDrive输送模块",
			"version_hash": 2161624877
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_2_DESC": {
			"string": "在面向消费者市场推出其工业级质量加速器铁雄HMX2000l的同时，一款之前仅供业内人士使用的模块也面向消费者开放，旨在帮助消费者改造其船只，使其能够使用该驱动器。尤其是对于那些无法使用其铁质输送系统或无法负担得起满足其要求的船只的船员。该模块对船只的输送系统进行了大幅调整，因此可用于改装大多数弹匣，以满足HMX那苛刻的弹药输送需求。\n\n多名操作员抱怨该设备在正常运行过程中产生大量噪音，但铁雄尚未就此事发表任何声明。",
			"version_hash": 1824627807
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_2_SPECS": {
			"string": "消耗品存储输送速度：+150%\n干重：9000 kg\n制造商：铁雄工程",
			"version_hash": 3987213318
		},
		"SHIP_YME": {
			"string": "Y-ME裂变改造",
			"version_hash": 318184807
		},
		"SHIP_YME_SPECS": {
			"string": "制造商：愤怒的前埃隆星际员工\n高强度挂载点：1\n低强度挂载点：2\n乘员上限：5\n干重：29300 kg\n货舱容量：140 m^3 \n成品矿物容量（每种）：11000 kg",
			"version_hash": 2674179350
		},
		"SHIP_YME_DESC": {
			"string": "这艘船是由埃隆星际公司的几名恼怒的员工创建的，他们因公司对员工和公关管理不善而离职。这些人联合起来打造了一艘经济性更强的船只，使得那些并非身处显赫职位的人也能更容易地接触到EIME这艘耀眼的船只。 \n\n由于EIME原始船体的特性，必须安装一个定制的离心液核反应堆，这是许多用户对原始船只的期望。在翻新过程中，使用了K37退役后为土卫二主站栖息地建设而留下的老旧型号，供应十分普遍。",
			"version_hash": 2278782411
		},
		"SYSTEM_REACTOR_EIME_REFIT": {
			"string": "离心液核替换反应堆",
			"version_hash": 4266291077
		},
		"SHIP_OCP-SALVAGE": {
			"string": "OCP-209打捞型",
			"version_hash": 2389090187
		},
		"SHIP_OCP-SALVAGE_SPECS": {
			"string": "制造商：友邦拓微工程\n舱内机械臂：1\n高强度挂载点：2\n低强度挂载点：2\n炮塔基座：2\n无人机舱：2\n乘员上限：8\n干重：214000 kg\n货舱容量：150 m^3\n成品矿物容量（合计）：50000 kg",
			"version_hash": 3111870258
		},
		"SHIP_OCP-SALVAGE_DESC": {
			"string": "这艘船是在辛太空工程公司后面的一个偏僻小巷里发现的。我们问能不能把它带走，在中庭工作的（无薪）实习生表示他无所谓，于是我们便拿走了。整个船舱都被挖掉，换上了一只机械臂，我们认为这在一定程度上是为了和MAD-CERF竞争，另一方面，也可能是因为辛太空工程公司在生产完OK720系列船只后，不知道该如何处理剩余的OCP材料。",
			"version_hash": 221069128
		},
		"SHIP_CK65": {
			"string": "CK-65",
			"version_hash": 216355051
		},
		"SHIP_CK65_SPECS": {
			"string": "制造商：康列多 / 俄原-安东诺夫\n低强度挂载点：2\n无人机挂载点：2\n乘员上限：12\n干重：78700 kg\n货舱容量：55 m^3\n成品矿物容量（每种）：37500 kg",
			"version_hash": 487980583
		},
		"SHIP_CK65_DESC": {
			"string": "矿物加工机的兴起催生了对能够携带大量货物进行星际旅行的船只的需求。拥有百年历史的科松级证明了自动化船只用于旅行的可行性，而勘探鹰则被选为完成这一新航程的首选船只。其货舱的绝大部分空间被改建为6个巨大的舱体，用于存放成品矿物，同时还配备了一个豪华的生活区，可容纳12名乘客。为了方便船长，勘探鹰的大部分硬件设施被保留了下来，但研磨机被替换为标准挖掘机，以确保更可靠的航行体验。",
			"version_hash": 3960488954
		},
		"SHIP_CK69": {
			"string": "CK-69",
			"version_hash": 216355055
		},
		"SHIP_CK69_SPECS": {
			"string": "制造商：康列多 / 俄原-安东诺夫\n低强度挂载点：2\n无人机挂载点：2\n乘员上限：12\n干重：102000 kg\n货舱容量：55 m^3\n成品矿物容量（合计）：200000 kg",
			"version_hash": 1892565817
		},
		"SHIP_CK69_DESC": {
			"string": "CK-65 的成功促成了更先进的 CK-69 的诞生，它能够处理任意类型的矿石，代价是总货舱容量略有降低。在土卫二吞吐量低谷期，标准版 CK-65 常因缺乏特定矿物而导致舱位闲置浪费，相比之下，CK-69 却备受矿工青睐，因为它能更可靠地运回大量矿石。",
			"version_hash": 2638684179
		},
		"SHIP_OCP213_TWIN": {
			"string": "OCP-213双子",
			"version_hash": 1918415372
		},
		"SHIP_OCP213_TWIN_SPECS": {
			"string": "制造商：友邦拓微工程\n高强度挂载点：2\n低强度挂载点：2\n接驳舱：2\n炮塔基座：2\n乘员上限：8\n干重：188000 kg\n货舱容量：610 m^3\n成品矿物容量（合计）：50000 kg",
			"version_hash": 802088103
		},
		"SHIP_OCP213_TWIN_DESC": {
			"string": "作为对标准OCP-209的小幅度改进，双子增加了第二个火炬喷口，以实现更多样化的机动，尤其是在结合平移和旋转时。",
			"version_hash": 2913326268
		},
		"SHIP_TRTL_PEEPER": {
			"string": "OCK窥视者TNTRL",
			"version_hash": 3422338455
		},
		"SHIP_TRTL_PEEPER_DESC": {
			"string": "这是辛太空工程公司OK720的定制改装版。船员居住区被移至货舱后方，以确保操作更加安全，使采矿活动产生的影响远离可能造成潜在伤害的区域。船首的非传统形状使挂载点大大偏离中心，但货舱上额外的结构配件使得高应力挂载点能够安装在船脊上。 \n\n由于重新安置的船员居住舱的位置特殊性，在居住舱和反应堆间安装了一个大型铅辐射防护罩，同时，在每次飞行期间及飞行后一个月内，船员每天可免费获得150毫克的Ketron Isoboost抗辐射药物。",
			"version_hash": 1103260156
		},
		"SHIP_TRTL_PEEPER_SPECS": {
			"string": "制造商：康列多 / 友邦拓微工程\n高强度挂载点：1\n低强度挂载点：4\n乘员上限：4\n干重：115700 kg\n货舱容量：555 m^3\n成品矿物容量（合计）：55000 kg",
			"version_hash": 2092457439
		},
		"SHIP_MADCERF_CIV_INVERSE_DESC": {
			"string": "这款与友邦拓微工程合作推出的民用改装型号，针对环带环境的多样化需求进行了多项改动。原先位于顶部的紧凑型居住舱已被移至舰首，并更换为符合OCP标准的扩容式离心居住舱，使有效乘员容量提升至八人。此外，为了适应采矿作业，对接舱也加装了网状吊篮并拆除了原有的对接夹具，舰体后舱壁则增设了一扇巨大的滑动舱门，用于装载大型货物。舰首的大部分内部结构也被改造成了货舱空间，使其在成品矿石的容纳能力上，超越了民用市场上的所有同类船只。\n\n针对该民用改装型号，还有一种第三方改装方案，通过调整自动驾驶系统与视觉传感器的朝向，使飞船能够以挖掘装置在前的姿态进行作业。",
			"version_hash": 2286313866
		},
		"SHIP_MADCERF_CIV_INVERSE_SPECS": {
			"string": "制造商：机器星际动力公司 / 友邦拓微工程\n高强度挂载点：1\n低强度挂载点：2\n炮塔挂载点：2\n无人机舱：2\n接驳舱：2\n乘员上限：8\n干重：241300 kg\n货舱容量：1175 m^3\n成品矿物容量（每种）：35000 kg",
			"version_hash": 1827786035
		},
		"SYSTEM_AUX_MPD_1400": {
			"string": "OPG-14“炽热离子”",
			"version_hash": 1526700951
		},
		"SYSTEM_AUX_MPD_1400_DESC": {
			"string": "极端功率需求，例如精炼站工业炉所需，需要极端功率解决方案，而友邦拓微型工程的“炽热离子”正是为此而生。由于其不同寻常的螺旋形转换室向回收出口逐渐变窄，爱好者与电气工程师（尽管两者之间几乎没有区别）都习惯称之为“松果”。 \n\n注意：本设备在达到其最大功率输出之前，可能需要短暂的预热。",
			"version_hash": 2076272883
		},
		"SYSTEM_AUX_MPD_1400_SPECS": {
			"string": "功耗：200 MW\n热耗：2.5 GW\n功率（标称）：1400 MW\n预热时间：5 s\n质量：12250 kg\n类型：MPDG\n制造商：友邦拓微工程",
			"version_hash": 1292112867
		},
		"SYSTEM_AUX_MPD_2000": {
			"string": "MPI城市级MPDG",
			"version_hash": 2751514767
		},
		"SYSTEM_AUX_MPD_2000_DESC": {
			"string": "这个该死的怪物级MPDG根本塞不进大多数飞船的船体，只能安装在外部，并通过多条馈线连接。它是火星及更远处大型定居点的终极动力源。 \n\n注意：该装置需要相当长的预热时间才能达到最大功率输出。MPI强烈建议您不要移除装置上的任何符印、雕刻或其他标记。",
			"version_hash": 3322090922
		},
		"SYSTEM_AUX_MPD_2000_SPECS": {
			"string": "功耗：300 MW\n热耗：4 GW\n功率（标称）：2,000 MW\n预热时间：15 s\n质量：16660 kg\n类型：带回收涡轮机组的MPDG\n制造商：火星动力工业",
			"version_hash": 3145271346
		},
		"SYSTEM_AUX_SMES_10K": {
			"string": "OPS-10电容器组",
			"version_hash": 2269000599
		},
		"SYSTEM_AUX_SMES_10K_DESC": {
			"string": "友邦拓微型工程的备用电源解决方案虽然不够优雅，但效果却令人难以置信。OPS-10基本只是在钢制外套中增加了一些超大容量的超级电容器，但它却能在峰值负载时提供惊人的功率输出，同时价格却与标准超级电容器系列相当。 \n\n由于未与内部冷却系统相连，OPS-10依靠缓慢的充电速率和笨重的辐射冷却器来控制其温度。",
			"version_hash": 912523547
		},
		"SYSTEM_AUX_SMES_10K_SPECS": {
			"string": "容量：10000 MJ\n充电功率：50 MW\n放电功率（峰值）：10000 MW \n质量：6500 kg \n类型：高密度分形石墨烯超级电容器阵列\n制造商：友邦拓微工程",
			"version_hash": 4056781120
		},
		"SYSTEM_CAPACITOR_100": {
			"string": "轻型超级电容",
			"version_hash": 2574788091
		},
		"SYSTEM_CAPACITOR_100_DESC": {
			"string": "一种圆柱形分形石墨烯超级电容，用于储存多余电力，以便在峰值使用期间提供。装置紧凑，价格合理。\n\n部分StarCAT能源管理系统曾被发现有将低能量系数误判为电力不足的情况，并会关闭各类非必要软件功能以试图防止该情况发生。",
			"version_hash": 3017059897
		},
		"SYSTEM_CAPACITOR_100_SPECS": {
			"string": "容量：100 MJ\n峰值功率：10 GW\n质量：400 kg\n制造商：友邦拓微工程",
			"version_hash": 3802359083
		},
		"SYSTEM_CAPACITOR_700": {
			"string": "ND-iSMB",
			"version_hash": 436615343
		},
		"SYSTEM_CAPACITOR_700_DESC": {
			"string": "中村动力内部超导磁电池是在NDAPS辅助动力单元取得成功后提出的一种替代性临时储能解决方案。尽管经过重重屏蔽以防止反作用工质等离子体干扰磁场，其与船舶电气总线的直接接口能够实现最大化的放电和充电速率，同时将损耗降至最低。",
			"version_hash": 3284585865
		},
		"SYSTEM_CAPACITOR_700_SPECS": {
			"string": "容量：700 MJ \n峰值功率：10 GW\n质量：1800 kg\n制造商：中村动力",
			"version_hash": 1657466468
		},
		"SYSTEM_CAPACITOR_1400": {
			"string": "ND-iSMB双耦合型",
			"version_hash": 1640893718
		},
		"SYSTEM_CAPACITOR_1400_DESC": {
			"string": "两台较小的iSMB单元通过重型功率平衡器连接。通过有意允许两个磁场之间的相互作用，可以在更小的硬件中有效存储更多能量。",
			"version_hash": 1268707516
		},
		"SYSTEM_CAPACITOR_1400_SPECS": {
			"string": "容量：1400 MJ\n峰值功率：10 GW\n质量：3200 kg\n制造商：中村动力",
			"version_hash": 4053885882
		},
		"SYSTEM_RODS_1": {
			"string": "1x SO6燃料棒",
			"version_hash": 1073794583
		},
		"SYSTEM_RODS_1_DESC": {
			"string": "这种俄原-安东诺夫SO6核燃料棒，通常被称为“太阳碎片”，是早期星际核热火箭设计的标准燃料。SO6采用液体钍基核心，被包裹在固体外壳中。其应力结构与材料成分使其能在极高运行温度下工作。 \n\n送给有志舰长的理想礼物。可根据需求提供多种设计和颜色的内衬铅包装材料。",
			"version_hash": 524843267
		},
		"SYSTEM_RODS_1_SPECS": {
			"string": "制造商：俄原-安东诺夫\n工作温度：3500 K\n融毁温度：4500 K\n质量：400 kg\n热功率：1 GW",
			"version_hash": 2761789210
		},
		"SYSTEM_TURBINE_20": {
			"string": "热电偶阵列",
			"version_hash": 1012257531
		},
		"SYSTEM_TURBINE_20_DESC": {
			"string": "这个简单的热电偶阵列利用飞船反应堆与推进剂之间的热梯度来发电。在此过程中，只有极少量的反应物质被排放到外部。",
			"version_hash": 2395727699
		},
		"SYSTEM_TURBINE_20_SPECS": {
			"string": "功率（标称）：20 MW \n推进剂消耗量：20 g/s\n质量：100 kg \n制造商：俄原-安东诺夫",
			"version_hash": 3551155359
		},
		"SYSTEM_TURBINE_160": {
			"string": "层流涡轮机",
			"version_hash": 4257331490
		},
		"SYSTEM_TURBINE_160_DESC": {
			"string": "这款裂变飞船发电装置利用德国工程技术的强大实力（以及人工智能优化设计），最大限度地减少了两个四级再生涡轮组件中的流动湍流和热量损失。",
			"version_hash": 272358522
		},
		"SYSTEM_TURBINE_160_SPECS": {
			"string": "功率（标称）：160 MW\n推进剂消耗量：160 g/s\n质量：600 kg\n制造商：玻尔兹曼热机",
			"version_hash": 830340465
		},
		"SYSTEM_TURBINE_320": {
			"string": "双重层流涡轮机",
			"version_hash": 3382055112
		},
		"SYSTEM_TURBINE_320_DESC": {
			"string": "这款裂变飞船发电装置利用德国工程技术的强大实力（以及人工智能优化设计），最大限度地减少了两个四级再生涡轮组件中的流动湍流和热量损失。反作用工质与压力通过新型固态阀体在两个机组之间均匀分配。",
			"version_hash": 255502870
		},
		"SYSTEM_TURBINE_320_SPECS": {
			"string": "功率（标称）：320 MW\n推进剂消耗量：320 g/s\n质量：1200 kg\n制造商：玻尔兹曼热机",
			"version_hash": 283092582
		},
		"SHIP_TSUKUYOMI_IOT": {
			"string": "月读级护卫舰（已退役）",
			"version_hash": 2331768936
		},
		"SHIP_TSUKUYOMI_IOT_DESC": {
			"string": "“月读”级轻型护卫舰设计于2190年，旨在执行太阳系内的各类军事任务。作为该类舰船的先驱，它们为现代战术护卫舰奠定了基础，其配备的五联装反应堆为强劲的推进器提供了巨大的动力。随着核盐水火箭发动机在军队中退役，许多该级舰船被拆解，或出售给了私人军事承包商及各类企业。\n\n承蒙辛太空工程船厂的帮助，该单位已完全解除武装并翻新，以适应在环区的作业需求。原有的盐水反应堆已被拆除，取而代之的是三个模块化容纳舱，以便加装现代核热火箭系统；舰首的鱼雷发射管隔板也被移除，从而扩大了货舱空间并增设了四个辅助设备舱。\n\n值得注意的是，“月读”级的设计本质上是战舰，而非货运飞船。因此，就好比货运面包车的载货空间远大于坦克一样，它的仓储容积低于人们对同体积舰艇的预期。",
			"version_hash": 1890888933
		},
		"SHIP_TSUKUYOMI_IOT_SPECS": {
			"string": "制造商：辛空间工程 / 中村动力\n高强度挂载点：1\n低强度挂载点：4\n接驳舱：4\n炮塔基座：2\n乘员上限：16\n干重：1351900 kg\n货舱容量：1100 m^3\n成品矿物容量（每种）：81000 kg",
			"version_hash": 1262598562
		},
		"SYSTEM_REACTOR_TSUYUKOMI_IOT-A": {
			"string": "月读反应堆堆芯A",
			"version_hash": 3308974745
		},
		"SYSTEM_REACTOR_TSUYUKOMI_IOT-B": {
			"string": "月读反应堆堆芯B",
			"version_hash": 3308974746
		},
		"SYSTEM_REACTOR_TSUYUKOMI_IOT-C": {
			"string": "月读反应堆堆芯C",
			"version_hash": 3308974747
		},
		"SHIP_OCP209_DD": {
			"string": "OCP-214-DD“深盘”",
			"version_hash": 2008633162
		},
		"SHIP_OCP209_DD_DESC": {
			"string": "214-DD是OCP-209的一个版本，专门为环区内的采矿作业而设计。其消耗品舱的支撑结构被挖空并加装护板，以扩展未加工货物容积，额外的电力基础设施则允许安装标准货舱配件。 \n\n尽管有显而易见的好处，但该船舱在处理矿石时显得笨拙，且缩减的船载矿物存储空间意味着船长们往往比驾驶其他大多数船型的同行更依赖辅助设备。",
			"version_hash": 2746927220
		},
		"SHIP_OCP209_DD_SPECS": {
			"string": "制造商：友邦拓微工程\n高强度挂载点：2\n低强度挂载点：2\n接驳舱：2\n无人机舱：2\n乘员上限：8\n干重：230300 kg\n货舱容量：675 m^3\n成品矿物容量（合计）：36000 kg",
			"version_hash": 2657881000
		},
		"SHIP_OCP209_SNAP": {
			"string": "OCP-207-SNAP“食人鱼”",
			"version_hash": 420116051
		},
		"SHIP_OCP209_SNAP_DESC": {
			"string": "207-SNAP是OCP-209的一个版本，采用了在原型开发阶段考虑过的挖掘机设计。它沉重的双门比其对应型号更适合压碎小行星——但不幸的是，也同样容易损坏它本应负责处理的那些脆弱设备。",
			"version_hash": 1684185953
		},
		"SHIP_OCP209_SNAP_SPECS": {
			"string": "制造商：友邦拓微工程\n高强度挂载点：2\n低强度挂载点：2\n接驳舱：2\n无人机舱：2\n乘员上限：8\n干重：230300 kg\n货舱容量：610 m^3\n成品矿物容量（合计）：50000 kg",
			"version_hash": 3629084377
		},
		"SHIP_COTHON_LUX": {
			"string": "SSE科松-2200-XL",
			"version_hash": 4266600797
		},
		"SHIP_COTHON_LUX_DESC": {
			"string": "这款科松-213三胞胎的非官方“现代化”变体配备了额外的“乘员舱”（救生舱）、一对额外的平移推进器，以及一系列“高级”功能，如组合式休息室和餐厅、带软垫的透气织物座椅以及功能齐全的卫生间。两个舱体在底部对接端口处连接在一起，并通过标准的紧急快速释放硬件固定在框架上。XL代表“额外的爱”。 \n\n辛空间工程不提供任何形式的明示或暗示担保。",
			"version_hash": 343966100
		},
		"SHIP_COTHON_LUX_SPECS": {
			"string": "制造商：辛空间工程 / 康列多 RVM\n低强度挂载点：4\n乘员上限：6\n干重：92000 kg\n货舱容量：260 m^3\n成品矿物容量（每种）：25000 kg",
			"version_hash": 1532414608
		},
		"SHIP_MADCERF_CIV": {
			"string": "MAD-CERF（民用改装）",
			"version_hash": 1400327038
		},
		"SHIP_MADCERF_CIV_DESC": {
			"string": "这款与友邦拓微工程合作推出的民用改装型号，针对环带环境的多样化需求进行了多项改动。原先位于顶部的紧凑型居住舱已被移至舰首，并更换为符合OCP标准的扩容式离心居住舱，使有效乘员容量提升至八人。此外，为了适应采矿作业，对接舱也加装了网状吊篮并拆除了原有的对接夹具，舰体后舱壁则增设了一扇巨大的滑动舱门，用于装载大型货物。舰首的大部分内部结构也被改造成了货舱空间，使其在成品矿石的容纳能力上，超越了民用市场上的所有同类船只。",
			"version_hash": 3053400826
		},
		"SHIP_MADCERF_CIV_SPECS": {
			"string": "制造商：机器星际动力公司 / 友邦拓微工程\n高强度挂载点：1\n低强度挂载点：2\n炮塔挂载点：2\n无人机舱：2\n接驳舱：2\n乘员上限：8\n干重：241300 kg\n货舱容量：1175 m^3\n成品矿物容量（每种）：35000 kg",
			"version_hash": 2079811827
		},
		"SHIP_MADCERF_DESC": {
			"string": "机器星际动力公司的Cernunnos II型飞船，又名MAD-CERF，是土星环内救援公司的标配舰船。其船头装甲厚重，适用于小行星带航行，虽不雅观，却能有效应对星际航行中遇到的诸多风险。飞船两侧各有一组反应堆，分别驱动各自的一对主推进器和机动推进器。",
			"version_hash": 906273873
		},
		"SHIP_OBERON": {
			"string": "UMC奥伯龙MLP-60",
			"version_hash": 230539627
		},
		"SHIP_OBERON_DESC": {
			"string": "奥伯龙MLP-60是由联合机械教派制造的一款奇特飞船。它最初是为轨道竞速赛事设计，由电磁轨道炮发射的自主载具。尽管后来被聚变推进机型取代，其库存还是很快被爱好者抢购一空，最终流入了环带。该飞船两侧各装有三组带式散热器，既能为高性能反应堆散热，又能为外露的燃料箱提供部分防护，不过鉴于该飞船拥有多得滑稽的平移推进器，这些散热器在机动时的实际防护作用其实微乎其微。\n\n为了适应环带的作业环境，该飞船经过了多项改装：原有的磁性连接装置被巧妙地改造为两个高强度挂载点；船首的小型货舱内加装了接口设施，以便搭载矿物处理单元（尽管空间极其局促，勉强才能容纳），此外，还加装了一个HAL-9001豪华救生舱，作为舒适的驾驶舱和船员舱。",
			"version_hash": 495024941
		},
		"SHIP_OBERON_SPECS": {
			"string": "制造商：联合机械教派 / 定制\n高强度挂载点：2\n无人机舱：1\n乘员上限：4\n干重：54000 kg\n货舱容量：50 m^3\n成品矿物容量（合计）：12000 kg",
			"version_hash": 2350388226
		},
		"SYSTEM_REACTOR_OBERON": {
			"string": "奥伯龙高性能反应堆",
			"version_hash": 1150005196
		},
		"SHIP_TRTL_RAM": {
			"string": "KX37 TNTRL“RAM”",
			"version_hash": 1990258218
		},
		"SHIP_TRTL_RAM_DESC": {
			"string": "KX37的“环友售后改装”版本，通常简称为“Ram”，是一种改装模式，自2269年由一位名为“BLKCandy”的RingChan用户发布后，便广受欢迎。该模式牺牲了一定的矿物容量，以引入电力及供弹导轨，用于在船体脊梁尾端增设两个无人机挂载点；同时将固定推进器支架替换为万向节型号，并重新设计了RCS喷口，以增强机动性。\n\n其最显著的特点是直接从废品市场获得的勘探者型研磨机。该设备的安装仅对船员舒适度做出了微小的让步，在运行过程中噪音极大，并略微减少了娱乐区的占地面积。",
			"version_hash": 2164652602
		},
		"SHIP_TRTL_RAM_SPECS": {
			"string": "制造商：俄原-安东诺夫/定制\n高强度挂载点：1\n低强度挂载点：2\n无人机舱：2\n乘员上限：4\n干重：46000 kg\n货舱容量：110 m^3\n成品矿物容量（合计）：37500 kg\nEMP屏蔽：50 MW",
			"version_hash": 86090113
		},
		"SYSTEM_REACTOR_TNTRL_FORT": {
			"string": "加固型K37核反应堆",
			"version_hash": 131474997
		},
		"SHIP_ATLAS_WASP": {
			"string": "黄蜂级侦察舰（已退役）",
			"version_hash": 2881116469
		},
		"SHIP_ATLAS_WASP_DESC": {
			"string": "中村动力黄蜂级自动战术侦察机制造于2200年代中期。采用[已编辑]作为动力源，并利用[已编辑]，只要车辆的[已编辑]处于[已编辑]状态，就能持续提供[已编辑]兆瓦的电能。机身大部分区域由法拉第笼式网格包裹，既能防止高密度太空环境中的静电放电，又能为[已编辑]提供便捷的电荷消散通道。\n\n是不是很有趣？这款由辛空间工程造船厂独家推出的机型，现已完全解密并退役，可能还处于某种法律灰色地带，并配备了一系列贴心配置，比如高性能反作用工质反作用轮；一个原本用来装载那什么已编辑玩意的空置“反应堆舱”（我们拿到手时它就是空的）；还有一个大概能用的货舱；最后还加装了康列多经典™改装救生舱，只为给你带来极致享受。\n\n保修？门都没有。开上这该死的飞船去浪吧，环友。另外，如果有人问你这东西是从哪里来的，给我们打个电话，把日志发过来，下次购物立减25%。",
			"version_hash": 3099079112
		},
		"SHIP_ATLAS_WASP_SPECS": {
			"string": "制造商：辛空间工程 / 中村动力\n低强度挂载点：2\n推进器基座万向节：36度\n乘员上限：3\n干重：23250 kg\n货舱容量：45 m^3\n成品矿物容量（每种）：500 kg\nEMP屏蔽：320 MW",
			"version_hash": 1946998285
