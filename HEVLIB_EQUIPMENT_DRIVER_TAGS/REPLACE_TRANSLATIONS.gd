		"SYSTEM_FUEL_1000000": {
			"string": "2x 货船级推进剂储罐阵列",
			"version_hash": 2936829597
		},
		"SYSTEM_FUEL_1000000_DESC": {
			"string": "一组双重排列的货船级推进剂储罐，可容纳高达1000000 kg的核热火箭推进剂。蜂窝状隔舱可防止机动过程中质量偏移。",
