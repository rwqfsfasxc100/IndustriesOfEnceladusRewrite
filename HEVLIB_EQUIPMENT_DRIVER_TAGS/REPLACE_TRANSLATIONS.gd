		"SYSTEM_AMMO_200_SPECS": {
			"string": "Масса: 200 кг \nПодача: 100 кг/с \nПроизводитель: Rasamama Material Solutions",
			"version_hash": 0
		},
		"SYSTEM_AMMO_100000": {
			"string": "Магазин снарядов класса верфи",
			"version_hash": 3522335561
		},
		"SYSTEM_AMMO_100000_DESC": {
			"string": "Обычно такие модули устанавливают на перевалочных верфях: они обеспечивают огромный запас боеприпасов для электромагнитных орудий, когда обычных поставок недостаточно. Опытный техник может приспособить блок для сверхтяжёлого корабля, рассчитанного на многонедельные операции.",
			"version_hash": 551948646
		},
		"SYSTEM_AMMO_100000_SPECS": {
			"string": "Вместимость: 100 000 кг\\nПодача: 1 000 кг/с\\nПроизводитель: Nakamura Dynamics",
			"version_hash": 534276821
