		"SYSTEM_HULLVAT_AMMO_1": {
			"string": "Дополнительная кассета с боеприпасами MPI",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_1_DESC": {
			"string": "Облегченный магазин, традиционно используемый для увеличения боезапаса на судах Vilcy, устанавивается в редко используемые коридоры судна. Несмотря на установку в качестве вспомогательной системы, магазину всё равно приходится использовать люк подачи боеприпасов для доставки боеприпасов к узлам подвески, что ограничивает скорость подачи боеприпасов скоростью, доступной для текущего магазина. Повреждение вентиляционных отверстий различными механизмами, используемыми для подачи боеприпасов в магазин, вызывает небольшую «заложенность», о которой сообщают экипажи, которые могут испытывать дискомфорт на судах, оборудованных такими системами, после длительного пребывания в них.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_1_SPECS": {
			"string": "Вместимость: 6,000 kg \nУменьшение хранилища нанодронов: 25% \nСобственная масса: 3,000 kg \nПроизводитель: Mars Power Industries ",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_MANUAL": {
			"string": "Дополнительные боеприпасы для кинетического оружия. Совместим с электромагнитными пушками и рельсотронами.\n Скорость подачи боеприпасов зависит от установленного магазина.\n Боеприпасы продаются отдельно на старте полета. \nДатчики HUD могут отображать новые значения правильно или неправильно.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_2": {
			"string": "ND Hollowed Hull Ammunition Magazine",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_2_DESC": {
			"string": "Первоначально основанный на контрабандных механизмах, применявшихся во время конфликтов, ND HHAM (часто называемый просто «Ham») использует свободное пространство в корпусе корабля для размещения целых 15 тонн дополнительного боекомплекта. Хотя обычно он предназначен для специалистов с лицензией Vilcy, Ham попал на гражданский рынок благодаря недавнему снижению требований к лицензированию, что позволило тем, у кого есть проблемы с пальцем на спусковом крючке, заниматься добычей без особых проблем, не вызывая синдрома Кесслера.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_2_SPECS": {
			"string": "Вместимость: 15,000 kg \nУменьшение хранилища нанодронов: 50% \nСобственная масса: 10,000 kg \nПроизводитель: Nakamura Dynamics ",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1": {
			"string": "Комплект расширения амуниции Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1_DESC": {
			"string": "Этот комплект использует переработанное складское пространство для хранения дополнительных снарядов, исходя из уже установленных комплектов. В связи с действующими на Энцеладе законами о маркировке оборудования, процент сокращения будет одинаковым для всех судов, что может привести к потенциальной потере места на многих судах. Однако это принесет пользу судам с меньшими внутренними трюмами или большей ёмкостью боезапаса, что позволит им получить меньшие потери или большую выгоду от соблюдения законов.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_1_SPECS": {
			"string": "Модификатор вместимости боезапаса: +33% \nВместимость боезапаса: 1,000 кг \nУменьшение хранилища переработанных минералов: 10% \nСобственная масса: 9000 кг \nПроизводитель: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2": {
			"string": "Двойной комплект расширения амуниции Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2_DESC": {
			"string": "Двойная муфта КРА от Conlindo с вдвое большей потенциальной мощностью и вдвое большими ограничениями. Из-за технических ограничений пришлось для одновременной работы двух механизмов масса увеличалась.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_2_SPECS": {
			"string": "Модификатор вместимости боезапаса: +67% \nВместимость боезапаса: 2,000 kg \nУменьшение хранилища переработанных минералов: 20% \nСобственная масса: 20,000 kg \nПроизводитель: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3": {
			"string": "Obonto Projectile Extendo+",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3_DESC": {
			"string": "Использует другой подход к расширению магазина электромагнитных пушек, нежели ранее, вместо этого жертвуя частью топливного бака. Из-за противоречивых законов Энцелада, он придерживается универсального подхода к проценту сокращения бака, но всегда гарантирует наличие 10 тонн топлива, даже если это означает, что топливо придётся хранить в том же контейнере, что и боеприпасы.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_AMMO_EXTEND_3_SPECS": {
			"string": "Модификатор вместимости боезапаса: +100% \nВместимость боезапаса: 1,000 kg \nУменьшение хранилища переработанных минералов: 33% \nСобственная масса: 35,000 kg \nПроизводитель: Obonto Microengineering",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_1": {
			"string": "Runasimi Drone Component Vat",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_1_DESC": {
			"string": "Как и многие коммерческие продукты Runasimi, DCV ориентирован на небольшое расширение имеющихся компонентов нанодрона. Изначально разработанный как резервный отсек, доступный только в чрезвычайных ситуациях, более поздние модели были разблокированы, чтобы их содержимое можно было использовать во время обычного полёта.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_1_SPECS": {
			"string": "Хранилище нанодронов: 6,000 kg \nУменьшение боезапаса: 25% \nСобственная масса: 4,500 kg \nПроизводитель: Runasimi ",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_MANUAL": {
			"string": "Дополнительные детали для сборки нанодронов. Совместимы со всеми пусковыми установками для дронов. \nСкорость доставки деталей дрона зависит от установленного магазина. \nКомпоненты дронов продаются отдельно на старте полета. \nДисплеи датчиков HUD могут отображать новые значения корректно или нет.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_2": {
			"string": "Runasimi Hull-Fitted Nanodrone Locker",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_2_DESC": {
			"string": "Благодаря успеху DCV было запущено в производство более крупное устройство, позволяющее пользователям, использующим нанодроны в больших количествах, эффективно использовать часто неиспользуемое пространство магазинов электромагнитных пушек, что позволило разместить значительно большую часть нанодронов. Отсутствие специальных предохранительных устройств позволило увеличить соотношение размеров деталей к пространству магазина по сравнению с предыдущими конструкциями.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_2_SPECS": {
			"string": "Хранилище нанодронов: 15,000 kg \nУменьшение боезапаса: 50% \nСобственная масса: 12,000 kg \nПроизводитель: Runasimi",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1": {
			"string": "Antonoff Nano Storage Expansion",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1_DESC": {
			"string": "Эта модификация, основанная на конструкции, аналогичной линейке боеприпасов в расширенных комплектах модернизации, заменяет часть трюма для минералов, позволяя хранить больше деталей нанодрона внутри судна. Обратите внимание, что к этим комплектам применяются те же законы, а допустимые отклонения в хранении привязаны к маркировке независимо от судна.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_1_SPECS": {
			"string": "Модификатор вместимости хранилища нанодронов: +33% \nХранилище нанодронов: 1,000 kg \nУменьшение хранилища переработанных минералов: 10% \nСобственная масса: 10,500 kg \nПроизводитель: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2": {
			"string": "Antonoff Dual Nano Storage Expansion",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2_DESC": {
			"string": "Аналогично конструкции комплектов для увеличения боеприпаса, компания Antonoff предложила двойную комплектацию для своих NSE. Аналогичные ограничения сохраняются.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_2_SPECS": {
			"string": "Модификатор вместимости хранилища нанодронов: +67% \nХранилище нанодронов: 2,000 kg \nУменьшение хранилища переработанных минералов: 20% \nСобственная масса: 25,000 kg \nПроизводитель: Antonoff",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3": {
			"string": "Obonto Liquid Nanobot Hold",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3_DESC": {
			"string": "Вариант комплекта Obonto Projectile Extendo+ для хранения нанодронов. Этот комплект заменяет довольно большую часть топливного бака для хранения дополнительных компонентов нанодрона. Этот вариант на удивление популярен среди строительных бригад, несмотря на проблемы с топливным хранилищем, вероятно, из-за недавнего смягчения правил, запрещающих использование буксирных и тяговых нанодронов при строительстве кольца.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_NANO_EXTEND_3_SPECS": {
			"string": "Модификатор вместимости хранилища нанодронов: +100% \nХранилище нанодронов: 1,000 kg \nУменьшение запаса рабочего тела: 33% \nСобственная масса: 40,000 kg \nПроизводитель: Obonto Microengineering",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_1": {
			"string": "Бак с топливом Mk. I",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_1_DESC": {
			"string": "Эти меньшие по размеру комплекты расширителей, созданные на основе исследований компании Conlindo в области динамических расширителей топливных баков, предназначены для бригад, занимающихся исследованиями, поисково-спасательными работами или строительством, поскольку в них остается много свободного пространства, остающегося после неиспользования обработанных хранилищ, и часть из них можно повторно использовать для размещения рабочего тела.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_1_SPECS": {
			"string": "Вместимость топлива: 10,000 kg \nУменьшение хранилища переработанных минералов: 10% \nСобственная масса: 1,500 kg \nПроизводитель: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_MANUAL": {
			"string": "Дополнительное рабочее тело для двигателей и турбин. \nРабочее тело продаётся отдельно в начале полета. \nДисплеи датчиков HUD могут отображать новые значения правильно или неправильно.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_2": {
			"string": "Бак с топливом Mk. II",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_2_DESC": {
			"string": "Представляя собой современное усовершенствование по сравнению с Mk. I, этот комплект использует более эффективные методы хранения, позволяя занимать меньше места на килограмм веса, чем его предшественник. Этот комплект всё ещё может оказаться не самым эффективным для некоторых экипажей, поскольку значительно более тяжёлая рама отпугнула некоторых капитанов, оценив его преимущества.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_2_SPECS": {
			"string": "Вместимость топлива: 25,000 kg \nУменьшение хранилища переработанных минералов: 22.5% \nСобственная масса: 7,000 kg \nПроизводитель: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1": {
			"string": "Расширитель бака рабочего тела",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1_DESC": {
			"string": "Стремясь к бесперебойным межпланетным перелётам, Конлиндо разработал это оборудование, позволяющее заменить часть магазина электромагнитных пушек и хранилища компонентов нанодронов, которые не используются при полётах на такие расстояния, чтобы вместить больше топлива в корабль. Несмотря на то, что стандартные межпланетные баки являются минимально необходимыми, дополнительный резерв позволяет пилотам совершать дополнительные манёвры, не рискуя опустошить бак и дрейфовать на протяжении всего пути.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_1_SPECS": {
			"string": "Модификатор вместимости топлива: +25% \nУменьшение боезапаса: 17% \nУменьшения хранилища нанодронов: 17% \nСобственная масса: 3,000 kg \nПроизводитель: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_2": {
			"string": "2x Расширитель бака рабочего тела",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_2_DESC": {
			"string": "Стремясь к бесперебойным межпланетным перелётам, Конлиндо разработал это оборудование, позволяющее заменить часть магазина электромагнитных пушек и хранилища компонентов нанодронов, которые не используются при перелётах на такие расстояния, чтобы вместить больше топлива в корабль. Несмотря на то, что стандартные межпланетные баки являются минимально необходимыми, дополнительный резерв позволяет пилотам совершать дополнительные манёвры, не рискуя опустошить бак и дрейфовать остаток пути.\n\nДвойная установка этого оборудования позволяет увеличить запас топлива для кораблей, которым это необходимо.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_2_SPECS": {
			"string": "Модификатор вместимости топлива: +50% \nУменьшение боезапаса: 25% \nУменьшения хранилища нанодронов: 25% \nСобственная масса: 8,000 kg \nПроизводитель: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_3": {
			"string": "3x Расширитель бака рабочего тела",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_3_DESC": {
			"string": "Стремясь к бесперебойным межпланетным перелётам, Конлиндо разработал это оборудование, позволяющее заменить часть магазина электромагнитных пушек и хранилища компонентов нанодронов, которые не используются при перелётах на такие расстояния, чтобы вместить больше топлива в корабль. Несмотря на то, что стандартные межпланетные баки являются минимально необходимыми, дополнительный резерв позволяет пилотам совершать дополнительные манёвры, не рискуя опустошить бак и дрейфовать остаток пути.\n\nТройная установка этого оборудования позволяет увеличить запас топлива для кораблей, которым это действительно необходимо.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_PROP_EXTEND_3_SPECS": {
			"string": "Модификатор вместимости топлива: +75% \nУменьшение боезапаса: 38% \nУменьшения хранилища нанодронов: 38% \nСобственная масса: 15,000 kg \nПроизводитель: Conlindo RVM",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_1": {
			"string": "Tetsuo SCARLETTE Delivery Driver",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_1_DESC": {
			"string": "Модуль SCARLETTE Driver предназначен для модернизации системы подачи расходных материалов к узлам подвески. Изначально использовавшийся в военных целях, SCARLETTE был переименован в промышленную модификацию после расторжения контрактов с Nakamura Dynamics. Несмотря на то, что он использовался преимущественно для промышленных электромагнитных пушек, некоторые капитаны с особенно высокими требованиями к электромагнитным пушкам смогли эффективно использовать этот модуль.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_1_SPECS": {
			"string": "Скорость доставки расходных материалов: +75% \nСобственная масса: 3,800 kg \nПроизводитель: Tetsuo Engineering",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_MANUAL": {
			"string": "Увеличивает скорость поставки соответствующих расходных материалов на определенный процент. \nНаиболее эффективно использовать в сочетании с промышленным оборудованием.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_2": {
			"string": "Модуль повышения эффективности подачи расходных материалов Tetsuo RamDrive",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_2_DESC": {
			"string": "В связи с выходом на потребительский рынок электромагнитных пушек промышленного класса Tetsuo HMX 2000l, которые ранее были доступны только для внктреннего использования, потребителям, желающим модернизировать свои суда, чтобы иметь возможность использовать их, особенно для экипажей, которые не могут воспользоваться системой подачи железа или не имеют возможности приобрести судно, отвечающее их требованиям, этот модуль вносит серьезные коррективы в системы доставки на судне и, как следствие, может быть использован для модернизации большинства магазинов, чтобы соответствовать абсурдным требованиям HMX к доставке боеприпасов.",
			"version_hash": 0
		},
		"SYSTEM_HULLVAT_CONSUMABLESPEED_2_SPECS": {
			"string": "Скорость доставки расходных материалов: +150% \nСобственная масса: 9,000 kg \nПроизводитель: Tetsuo Engineering",
			"version_hash": 0
		},
		"SHIP_YME": {
			"string": "Y-ME Fission Retrofit",
			"version_hash": 0
		},
		"SHIP_YME_SPECS": {
			"string": "Производитель: Злые бывшые работники-Eon Interstellar \nВысокопрочные подвесы: 1\nМалопрочные подвесы: 2\nЭкипаж: 5\nСухая масса: 34,500 kg \nОбъём грузового отсека: 140 m^3 \nХранилище переработанной руды (на каждый тип): 11,000 kg",
			"version_hash": 0
		},
		"SHIP_YME_DESC": {
			"string": "Этот корабль был создан несколькими недовольными сотрудниками Eon Interstellar, которые отделились из-за неэффективного управления компанией как своими сотрудниками, так и отделом по связям с общественностью. Они объединились, чтобы создать более экономически выгодное судно, сделав сияющий корпус EIME более доступным для тех, кто не занимает высокооплачиваемые должности. \n\nИз-за особенностей оригинального корпуса EIME пришлось установить специальный реактор с жидкостным барабаном, чего хотели многие конечные пользователи оригинального судна. Для модернизации был использован старый реактор, оставшийся от K37, списанных для строительства жилых зон Энцелада Прайм, поскольку он был в общем распоряжении.",
			"version_hash": 0
		},
		"SYSTEM_REACTOR_EIME_REFIT": {
			"string": "Реактор для замены жидкостного барабана",
			"version_hash": 0
		},
		"SHIP_OCP-SALVAGE": {
			"string": "OCP-209 Спасенный корпус",
			"version_hash": 0
		},
		"SHIP_OCP-SALVAGE_SPECS": {
			"string": "Производитель: Obonto Microengineering\nМанипуляторы встроенные в отсек: 1\nВысокопрочные подвесы: 2\nМалопрочные подвесы: 2\nЭкипаж: 8\nСухая масса: 184,500 kg\nОбъём грузового отсека: да\nХранилище переработанной руды (общее): 50,000 kg",
			"version_hash": 0
		},
		"SHIP_OCP-SALVAGE_DESC": {
			"string": "Этот корабль был найден в переулке за Sin Space Engineering. Мы спросили, можем ли мы его забрать, но (неоплачиваемый) стажёр, работающий в атриуме, сказал, что ему всё равно, и мы забрали. Весь грузовой отсек был вырезан и заменён манипулятором, как мы полагаем, отчасти для того, чтобы создать конкурента MAD-CERF, а отчасти потому, что Sin Space Engineering не знала, что делать с остальной частью OCP после создания линейки кораблей OK720.",
			"version_hash": 0
		},
		"SHIP_CK65": {
			"string": "CK-65",
			"version_hash": 0
		},
		"SHIP_CK65_SPECS": {
			"string": "Производитель: Conlindo / Rusatom-Antonoff\nМалопрочные подвесы: 2\nПодвесы для дронов: 2\nЭкипаж: 12\\Сухая масса: 82,000 kg \nОбъём грузового отсека: 40 m^3\nХранилище переработанной руды (на каждый тип): 37,500 kg",
			"version_hash": 0
		},
		"SHIP_CK65_DESC": {
			"string": "Расцвет переработки полезных ископаемых обусловил потребность в кораблях, способных перевозить значительные объёмы этого сырья для межпланетных перелётов. Столетний опыт создания кораблей класса «Cothon» продемонстрировал жизнеспособность автоматизированных кораблей для путешествий, и «Eagles» были выбраны в качестве судна для завершения нового проекта. Значительная часть грузового отсека была урезана, чтобы разместить шесть гигантских отсеков для хранения обработанных грузов, а также роскошный жилой отсек для 12 пассажиров. Значительная часть оборудования «Орла» была оставлена ​​для удобства капитанов, однако дробилка была заменена стандартным экскаватором для повышения надёжности.",
			"version_hash": 0
		},
		"SHIP_CK69": {
			"string": "CK-69",
			"version_hash": 0
		},
		"SHIP_CK69_SPECS": {
			"string": "Производитель: Conlindo / Rusatom-Antonoff\nМалопрочные подвесы: 2\nПодвесы для дронов: 2\nЭкипаж: 12\nСухая масса: 102,000 kg \nОбъём грузового отсека: 40 m^3 \nХранилище переработанной руды (общее): 200,000 kg",
			"version_hash": 0
		},
		"SHIP_CK69_DESC": {
			"string": "Успех CK-65 привёл к созданию более совершенной модели CK-69, способной обрабатывать любые объёмы руды, но ценой несколько меньшего общего объёма трюма. Он использовался во время спадов производительности на Энцеладе, когда стандартный CK-65 терял место из-за отсутствия определённого минерала. Тем не менее, он был очень популярен среди шахтёров, которые могли надёжнее добывать большие объёмы руды.",
			"version_hash": 0
		},
		"SHIP_OCP213_TWIN": {
			"string": "OCP-213 Twin",
			"version_hash": 0
		},
		"SHIP_OCP213_TWIN_SPECS": {
			"string": "Производитель: Obonto Microengineering\nВысокопрочные подвесы: 2\nМалопрочные подвесы: 2\nЭкипаж: 8\nСухая масса: 187,500 kg\nОбъём грузового отсека: 610 m^3\nХранилище переработанной руды (общее): 50,000 kg",
			"version_hash": 0
		},
		"SHIP_OCP213_TWIN_DESC": {
			"string": "Незначительная модификация стандартной модели OCP-209. Twin добавляет второе крепление для горелки и разделяет их в V-образной форме, что позволяет выполнять более разнообразные маневры, особенно при комбинировании перемещения и вращения.",
			"version_hash": 0
		},
		"SHIP_TRTL_PEEPER": {
			"string": "OCK Peeper TNTRL",
			"version_hash": 0
		},
		"SHIP_TRTL_PEEPER_DESC": {
			"string": "Модификация OK720 компании Sin Space Engineering, изготовленная по индивидуальному заказу. Жилой отсек для экипажа перенесён за грузовой отсек для повышения безопасности и снижения вероятности травмирования при горных работах. Необычная форма носовой части корабля значительно смещает узлы подвески относительно центра, однако дополнительные структурные элементы отсека позволяют разместить высокопрочный узел подвески вдоль хребта. \n\nВ связи с особенностями изменённого расположения жилого отсека для экипажа между ними установлен большой свинцовый экран радиационной защиты, а также экипажи получают бесплатный препарат Ketron Isoboost в дозе 150 мг в день во время и в течение месяца после полёта на этом судне.",
			"version_hash": 0
		},
		"SHIP_TRTL_PEEPER_SPECS": {
			"string": "Производитель: Conlindo / Obonto Microengineering \nВысокопрочные подвесы: 1 \nМалопрочные подвесы: 4 \nЭкипаж: 4 \nСухая масса: 101,400 kg \nОбъём грузового отсека: 600 m^3 \nХранилище переработанной руды (общее): 25,000 kg",
			"version_hash": 0
		},
		"SHIP_MADCERF_CIV_INVERSE_DESC": {
			"string": "Эта гражданская переделка, созданная совместно с Obonto Microengineering, приспосабливает корабль к разным задачам в кольцах. Компактный верхний жилой модуль перенесён в нос и заменён увеличенной центрифугой стандарта OCP, благодаря чему экипаж вырос до восьми человек. Стыковочный отсек закрыт сетчатой корзиной, а захваты сняты ради добывающих работ. В кормовой переборке установлена огромная раздвижная дверь для крупного груза. Значительная часть носовой конструкции также отдана под хранилища, поэтому переработанной руды помещается больше, чем на любом другом гражданском корабле.\\n\\nСторонняя модификация этой переделки разворачивает автопилот и оптические датчики вперёд, чтобы корабль летел экскаватором первым.",
			"version_hash": 2286313866
		},
		"SHIP_MADCERF_CIV_INVERSE_SPECS": {
			"string": "Производители: Machines Astro-Dynamiques / Obonto Microengineering\\nВысокопрочные подвесы: 1\\nМалопрочные подвесы: 2\\nПодвесы турелей: 2\\nОтсеки дронов: 2\\nСтыковочные отсеки: 2\\nЭкипаж: 8\\nСухая масса: 241 300 кг\\nОбъём грузового отсека: 1 175 м³\\nХранилище переработанной руды (на каждый тип): 35 000 кг",
			"version_hash": 1827786035
		},
		"SYSTEM_AUX_MPD_1400": {
			"string": "OPG-14 StatPlasma",
			"version_hash": 0
		},
		"SYSTEM_AUX_MPD_1400_DESC": {
			"string": "Для экстремальных условий эксплуатации, таких как промышленные печи перерабатывающих заводов, требуется решение с экстремальной мощностью, и StatPlasma от Obonto Microengineering — именно то, что нужно. Энтузиасты и инженеры-электрики (хотя различий мало) называют его «шишкой» из-за необычной винтовой камеры преобразования, которая сужается к выходному отверстию для сбора пара. \n\nПримечание: этому устройству может потребоваться небольшой прогрев для достижения полной выходной мощности.",
			"version_hash": 0
		},
		"SYSTEM_AUX_MPD_1400_SPECS": {
			"string": "Энергопотребление: 200 МВт \nПотребление тепла: 2,5 ГВт \nМощность (номинальная): 1400 МВт \nВремя прогрева: 5 с \nМасса: 12 250 кг \nТип: МПДГ \nПроизводитель: Obonto Microengineering",
			"version_hash": 0
		},
		"SYSTEM_AUX_MPD_2000": {
			"string": "MPDG класса MPI City",
			"version_hash": 0
		},
		"SYSTEM_AUX_MPD_2000_DESC": {
			"string": "Этот чудовищный МПДГ буквально не помещается в корпус большинства кораблей, его приходится монтировать снаружи и подключать к нескольким линиям питания. Мощная электростанция для крупных поселений на Марсе и за его пределами. \n\nПримечание: этому устройству требуется длительный прогрев, прежде чем оно достигнет полной мощности. MPI настоятельно рекомендует не удалять никакие маркировки, гравировки или другие отметки с устройства.",
			"version_hash": 0
		},
		"SYSTEM_AUX_MPD_2000_SPECS": {
			"string": "Энергопотребление: 300 МВт \nПотребление тепла: 4 ГВт \nМощность (номинальная): 2000 МВт \nВремя прогрева: 15 с \nМасса: 16 660 кг \nТип: МПДГ с турбиной-утилизатором \nПроизводитель: Mars Power Industries",
			"version_hash": 0
		},
		"SYSTEM_AUX_SMES_10K": {
			"string": "Конденсаторная батарея OPS-10",
			"version_hash": 0
		},
		"SYSTEM_AUX_SMES_10K_DESC": {
			"string": "Решение Obonto Microengineering для резервного питания, несмотря на свою неэлегантность, невероятно эффективно. По сути, OPS-10 представляет собой несколько сверхбольших ультраконденсаторов в стальном корпусе, он может обеспечивать феноменальную выходную мощность при пиковой нагрузке, оставаясь при этом примерно таким же доступным, как и стандартные ультраконденсаторы. \n\nПоскольку OPS-10 не подключен к внутренним системам охлаждения, для поддержания температуры в нём используются медленная зарядка и громоздкий радиатор.",
			"version_hash": 0
		},
		"SYSTEM_AUX_SMES_10K_SPECS": {
			"string": "Емкость: 10 000 МДж \nЭнергопотребление: 50 МВт \nВыходная мощность (пиковая): 10 000 МВт \nМасса: 6 500 кг \nТип: Массив фрактальных ультраконденсаторов на основе графена высокой плотности \nПроизводитель: Obonto Microengineering",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_100": {
			"string": "Лёгкий ультраконденсатор",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_100_DESC": {
			"string": "Фрактальный графеновый цилиндрический ультраконденсатор для хранения избыточной выработанной энергии, обеспечивающий её доступность в периоды пиковой нагрузки. Компактное устройство по разумной цене.",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_100_SPECS": {
			"string": "Емкость: 100 МДж \nПиковая мощность: 10 ГВт \nМасса: 400 кг \nПроизводитель: Obonto Micro Engineering",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_700": {
			"string": "ND-iSMB",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_700_DESC": {
			"string": "Внутренняя сверхпроводящая магнитная батарея Nakamura Dynamics — это альтернативное решение для временного хранения энергии, предложенное после успеха вспомогательной энергетической установки NDAPS. Несмотря на мощную защиту от воздействия плазмы перемассировки, его прямое подключение к электрическим шинам судна обеспечивает максимальную скорость разряда и перезаряда с минимальными потерями.",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_700_SPECS": {
			"string": "Емкость: 700 МДж \nПиковая мощность: 10 ГВт \nМасса: 1800 кг \nПроизводитель: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_1400": {
			"string": "Двойная связь ND-iSMB",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_1400_DESC": {
			"string": "Два меньших блока iSMB, соединённых мощным балансиром мощности. Благодаря преднамеренному взаимодействию двух магнитных полей, больше энергии может эффективно храниться в меньшем оборудовании.",
			"version_hash": 0
		},
		"SYSTEM_CAPACITOR_1400_SPECS": {
			"string": "Емкость: 1400 МДж \nПиковая мощность: 10 ГВт \nМасса: 3200 кг \nПроизводитель: Nakamura Dynamics",
			"version_hash": 0
		},
		"SYSTEM_RODS_1": {
			"string": "1 топливный стержень SO6",
			"version_hash": 0
		},
		"SYSTEM_RODS_1_DESC": {
			"string": "Этот топливный стержень SO6 производства Rusatom-Antonoff, обычно называемый «солнечным осколком», является стандартным топливом для ранних проектов межпланетных ядерных реакторов (ЯТР). В SO6 используется жидкое ядро ​​на основе тория, заключенное в твердую оболочку. Напряжение и состав обеспечивают чрезвычайно высокие рабочие температуры. \n\nИдеальный подарок для будущего капитана корабля. Свинцовая упаковка различных дизайнов и цветов доступна по запросу.",
			"version_hash": 0
		},
		"SYSTEM_RODS_1_SPECS": {
			"string": "Производитель: Rusatom-Antonoff \nРабочая температура: 3,500 K \nТочка отказа: 4,500 K \nМасса: 400 kg \nТеплоотдача: 1 GW",
			"version_hash": 0
		},
		"SYSTEM_TURBINE_20": {
			"string": "Термопарная установка",
			"version_hash": 0
		},
		"SYSTEM_TURBINE_20_DESC": {
			"string": "Эта простая термопарная установка использует тепловой градиент между реактором судна и топливом для выработки электроэнергии. При этом за борт выбрасывается незначительное количество реакционной массы.",
